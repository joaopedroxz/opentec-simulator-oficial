      { id: 400, domain: "Core Configuration & Security", question: "Which roles are required to configure the form layout using Table Builder? (Choose two.)", options: ["read_only_user", "it_support_specialist", "app_engine_admin", "admin", "personalize_form"], answer: [2, 3] },
      { id: 401, domain: "Core Configuration & Security", question: "An Administrator wants to review all the users having privileged access to identify users that no longer need this level of access. Which Security Center feature can help fulfil this requirement?", options: ["Security hardening", "Security posture console", "Security scanner", "Customer actions"], answer: 1 },
      { id: 402, domain: "Core Configuration & Security", question: "What encryption feature is included in ServiceNow by default?", options: ["Data in transit", "Data at rest", "Data in use"], answer: 0 },
