      { id: 376, domain: "User Interface & Navigation", question: "Which action enables a user to view and specify date and time formats in their instance?", options: ["Select the User menu > Preferences > Time Settings > Toggle display time zone", "Ask the user to adjust the time zone on their personal computer", "Use the system properties to correct the instance's time zone", "Select the User menu > Preferences > Language & Region > Set date and time format and time zone", "Create a UI Script to set the default timezone"], answer: 3 },
