      { id: 356, domain: "User Interface & Navigation", question: "Which displays the list of activities, or history, on a form?", options: ["Formatter", "Dictionary", "Sidebar", "History Menu"], answer: 0 },
      { id: 357, domain: "User Interface & Navigation", question: "Where should an administrator navigate to add the \"Save\" button in the form header?", options: ["Context Menu > Form Design", "All > System Properties > UI Action Settings", "All > System Properties > UI Properties", "Context Menu > Form Layout"], answer: 2 },
      { id: 358, domain: "Service Automation & Process Automation", question: "What are the options that can be set to determine when a Business Rule executes? (Choose four.)", options: ["Async", "Load", "Change", "Display", "After", "Before", "Submit", "Click"], answer: [0, 3, 4, 5] },
      { id: 359, domain: "User Interface & Navigation", question: "Which path is used on the Filter Navigator to display the list of records from the sys_user table?", options: ["sys_user.display", "sys_user.do", "sys_user.list", "sys_user.view"], answer: 2 },
      { id: 360, domain: "Core Configuration & Security", question: "Which access control rule applies to every field in the incident table?", options: ["incident<=>*", "incident.all", "incident.*", "incident||*"], answer: 2 },
      { id: 361, domain: "Core Configuration & Security", question: "What is the purpose of an application scope?", options: ["Scope determines which parts of an application are available for use by other applications In ServiceNow", "Scope prevents applications from changing their own tables and business logic", "Scope determines the functionality of core services in the platform", "Scope determines all applications access each other's tables and business logic"], answer: 0 },
      { id: 362, domain: "User Interface & Navigation", question: "On a Catalog Task record, how would an administrator change the priority choice options?", options: ["In the Context menu of the form, select Configure Options", "Right-click the Priority Label > select Configure Lists", "Right-click the Priority Label > select Configure Choices", "Open the Data Dictionary > select Values"], answer: 2 },
      { id: 363, domain: "Core Configuration & Security", question: "Which sequence of actions applies an update set to an instance?", options: ["Preview, Save, Commit", "Preview, Retrieve, Commit", "Retrieve, Commit, Preview", "Retrieve, Preview, Commit"], answer: 3 },
      { id: 364, domain: "Service Automation & Process Automation", question: "A customer asks you to make the following updates to a form: 1. When Caller field is populated, automatically look up caller location and load it in the Location field. 2. Add notice at the top of the page when the record is submitted. What type of script would you use to meet this requirement?", options: ["UI script", "Server script", "JavaScript", "Client script"], answer: 3 },
