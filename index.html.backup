      { id: 381, domain: "Core Configuration & Security", question: "What policies are applied to all data entered into the platform (i.e. through a record form (UI), Import Sets, or Web Services)?", options: ["Data Policies", "Write Policies", "Data Integrity Policies", "Data Submission Policies"], answer: 0 },
