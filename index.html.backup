<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Opentec Simulator - ServiceNow CSA</title>
  <!-- Favicon adicionado -->
  <link rel="icon" type="image/png" href="https://opentec.com.br/wp-content/uploads/2022/05/logo_tranparente.png" onerror="this.href='https://opentec.com.br/wp-content/uploads/2022/05/logo_tranparente.png'">
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- React & ReactDOM -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <!-- Babel -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <!-- Fontes -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            snGreen: '#81B5A1',
            snDarkGreen: '#032D29',
            snNavy: '#1E293B',
            companyRed: '#E8605D',
            companyRedHover: '#D94D4A'
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(0,0,0,0.05); }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 3px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.25); }
    
    /* Adicionado para efeito 3D nos Flashcards */
    .perspective-1000 { perspective: 1000px; }
    .transform-style-3d { transform-style: preserve-3d; }
    .backface-hidden { backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col selection:bg-snGreen selection:text-slate-950">
  <div id="root" class="flex-1 flex flex-col"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo, useCallback, useRef } = React;

    // --- BANCO DE DADOS COMPLETO COM TODAS AS QUESTÕES ---
    const FULL_250_QUESTIONS = [
      { id: 1, domain: "Collaboration & Service Catalog", question: "A Service Catalog may include which of the following components?", options: ["Order Guides, Exchange Rates, Calendars", "Order Guides, Catalog Items, and Interceptors", "Catalog Items, Asset Contracts, Task Surveys", "Record Producers, Order Guides, and Catalog Items"], answer: 3, explanation: "O Service Catalog é composto principalmente por Record Producers, Order Guides e Catalog Items, além de variáveis de catálogo.", hint: "Pense nos três principais elementos que um usuário final solicita no catálogo." },
      { id: 2, domain: "Data Migration & Integration", question: "Which one of the following statements applies to a set of fields when they are coalesced during an import?", options: ["If a match is found using the coalesce fields, the existing record is updated with the information being imported", "If a match is not found using the coalesce fields, the system does not create a Transform Map", "If a match is found using the coalesce fields, the system creates a new record", "If a match is not found using the coalesce fields, the existing record is updated with the information being imported"], answer: 0, explanation: "O recurso Coalesce funciona como chave única de busca. Se houver correspondência, o registro existente é atualizado com as novas informações.", hint: "Coalesce serve para evitar duplicidades identificando registros existentes." },
      { id: 3, domain: "Service Automation & Process Automation", question: "As it relates to ServiceNow reporting, which of the following statements describes what a metric can do?", options: ["A metric is a report gauge used on homepages to display real-time data", "A metric is a time measurement used to report the effectiveness of workflows and SLAs", "A metric is used to measure and evaluate the effectiveness of IT service management processes", "A metric is a comparative measurement used to report the effectiveness of flows and SLAs."], answer: 2, explanation: "Métricas no ServiceNow medem a eficácia de processos de ITSM ao rastrear dados ao longo do tempo (como duração de um estado específico).", hint: "Métricas medem o desempenho de processos de TI." },
      { id: 4, domain: "Collaboration & Service Catalog", question: "The display sequence is controlled in a Service Catalog Item using which of the following?", options: ["The Default Value field in the Catalog Item form", "The Sequence field in the Catalog Item form", "The Order field in the Variable form", "The Choice field in the Variable form"], answer: 2, explanation: "O campo 'Order' (Ordem) no formulário da variável define a sequência numérica de exibição do campo no formulário do catálogo.", hint: "Campo numérico (ex: 100, 200) usado para ordenação." },
      { id: 5, domain: "User Interface & Navigation", question: "Reports can be created from which different places in the platform? (Choose two.)", options: ["List column heading", "Metrics module", "Statistics module", "View / Run module"], answer: [0, 3], explanation: "Relatórios rápidos podem ser gerados direto no menu de contexto do cabeçalho da coluna de uma lista ou criados no módulo Reports > View / Run.", hint: "Um fica no topo das colunas de listas e o outro é o módulo principal de relatórios." },
      { id: 6, domain: "Collaboration & Service Catalog", question: "Knowledge Base Search results can be sorted by which of the following? (Choose three.)", options: ["Most recent update", "Popularity", "Relevancy", "Manager assignment", "Number of views"], answer: [0, 2, 4], explanation: "Os resultados de busca na Base de Conhecimento permitem ordenação por Relevância, Atualização mais recente (Most recent) e Número de visualizações (Views).", hint: "Relevância, atualizações recentes e contagem de acessos." },
      { id: 7, domain: "Collaboration & Service Catalog", question: "What is the path an Administrator could take to view the fulfillment stage task list for an order placed by a user?", options: ["RITM (Number)>REQ (Number)>PROCUREMENT (Number)", "REQ (Number)>RITM (Number)>PROCUREMENT (Number)", "REQ (Number)>RITM (Number)>TASK (Number)", "FULFILLMENT (Number)>RITM (Number)>TASK (Number)"], answer: 2, explanation: "A hierarquia padrão do Service Catalog é: Requisição Geral (REQ) -> Item Solicitado (RITM) -> Tarefas de Atendimento (SCTASK).", hint: "A ordem vai do pedido geral (REQ) para o item (RITM) e depois para a tarefa (TASK)." },
      { id: 8, domain: "User Interface & Navigation", question: "Which term refers to application menus and modules which you may want to access quickly and often?", options: ["Breadcrumb", "Favorite", "Tag", "Bookmark"], answer: 1, explanation: "Os Favoritos (ícone de estrela) no navegador da aplicação permitem armazenar atalhos diretos para módulos ou registros frequentes.", hint: "Identificado por um ícone de estrela." },
      { id: 9, domain: "Collaboration & Service Catalog", question: "What is generated from the Service Catalog once a user places an order for an item or service?", options: ["A change request", "An Order Guide", "A request", "An SLA"], answer: 2, explanation: "Ao finalizar a compra de um item no Service Catalog, uma Requisição (`sc_request` - REQ) é gerada como pedido mestre no sistema.", hint: "O registro mestre gerado ao submeter o carrinho." },
      { id: 10, domain: "Core Configuration & Security", question: "From the User menu, which actions can a user select? (Choose three.)", options: ["Send Notifications", "Log Out ServiceNow", "Elevate Roles", "Impersonate Users", "Order from Service Catalog", "Approve Records"], answer: [1, 2, 3], explanation: "No menu de perfil do usuário (canto superior direito), é possível fazer Logout, Elevar Papéis (Elevate Roles para `security_admin`) e Personificar Usuários (Impersonate).", hint: "Funções de controle de sessão e privilégios localizadas no cabeçalho superior." },
      { id: 11, domain: "Service Automation & Process Automation", question: "Buttons, form links, and context menu items are all examples of what type of functionality?", options: ["Business Rule", "UI Action", "Client Script", "UI Policy"], answer: 1, explanation: "UI Actions são elementos visuais interativos na interface como botões, links de formulário e itens de menu de contexto que executam scripts ou ações.", hint: "Ações acionáveis na interface do usuário." },
      { id: 12, domain: "Collaboration & Service Catalog", question: "Which of the following is true of Service Catalog Items in relation to the Service Catalog?", options: ["They run behind the scenes.", "They are the building blocks.", "They are optional.", "They provide options."], answer: 1, explanation: "Os Catalog Items são considerados os blocos fundamentais de construção (building blocks) que compõem o catálogo de serviços.", hint: "Termo que significa 'blocos de construção'." },
      { id: 13, domain: "Core Configuration & Security", question: "Table Access Control rules are processed in the following order:", options: ["any table name (wildcard), parent table name, table name", "table name, parent table name, any table name (wildcard)", "parent table name, table name, any table name (wildcard)", "any table name (wildcard), table name, parent table name"], answer: 1, explanation: "A verificação das regras de ACL de tabela ocorre da mais específica para a mais geral: Tabela Específica -> Tabela Pai -> Wildcard (*).", hint: "Do específico para o genérico (*)." },
      { id: 14, domain: "Database Administration & CMDB", question: "What is the platform name for the User table?", options: ["u users", "sys_users", "x users", "sys_user"], answer: 3, explanation: "A tabela nativa do sistema que armazena os usuários é a `sys_user` (no singular).", hint: "Começa com sys_ e está no singular." },
      { id: 15, domain: "Collaboration & Service Catalog", question: "A REQ number in the Service Catalog represents", options: ["the order number.", "the stage.", "the task to complete.", "the individual item in the order."], answer: 0, explanation: "O número REQ representa o número do pedido completo (Order Number), que pode conter um ou mais itens solicitados (RITM).", hint: "Representa o número do pedido total do carrinho." },
      { id: 16, domain: "User Interface & Navigation", question: "Which would NOT appear in the History section of the Application Navigator?", options: ["Records", "UI Pages", "Lists", "Forms"], answer: 1, explanation: "O histórico de navegação rastreia registros, formulários e listas acessados recentemente, mas não adiciona UI Pages puras ao histórico.", hint: "Páginas customizadas de interface (UI Pages) não entram no histórico automático." },
      { id: 17, domain: "Core Configuration & Security", question: "Which one of the following statements is a recommendation from ServiceNow about Update Sets?", options: ["Avoid using the Default Update set as an Update Set for moving customizations from instance to instance", "Before moving customizations from instance to instance with Update Sets, ensure that both instances are different versions", "Use the Baseline Update Set to store the contents of items after they are changed the first time", "Once an Update Set is closed as Complete, change it back to In Progress until it is applied to another instance"], answer: 0, explanation: "A ServiceNow recomenda criar sempre Update Sets personalizados nomeados e evitar mover o Default Update Set entre instâncias.", hint: "Nunca utilize o 'Default' para transportar alterações entre ambientes." },
      { id: 18, domain: "Service Automation & Process Automation", question: "Which of the following is used to initiate a flow?", options: ["A Trigger", "Core Action", "A spoke", "An Event"], answer: 0, explanation: "Um fluxo no Flow Designer inicia-se através de um Gatilho (Trigger), que define as condições ou momento de execução.", hint: "O elemento que define QUANDO o fluxo é acionado." },
      { id: 19, domain: "Collaboration & Service Catalog", question: "For Administrators creating new Service Catalog items, what is a characteristic they should know about Service Catalog variables?", options: ["Service Catalog variables can only be used in Record Producers", "Service Catalog variables can only be used in Order Guides", "Service Catalog variables cannot affect the order price", "Service Catalog variables are global by default"], answer: 3, explanation: "Variáveis criadas para o catálogo de serviços possuem escopo global por padrão no ServiceNow.", hint: "Possuem alcance global padrão na plataforma." },
      { id: 20, domain: "User Interface & Navigation", question: "Which one of the following statements is true about Column Context Menus?", options: ["It displays actions such as creating quick reports, configuring the list, and exporting data", "It displays actions related to filtering options, assigning tags, and search", "It displays actions related to viewing and filtering the entire list", "It displays actions such as view form, view related task, and add relationship"], answer: 0, explanation: "O menu contextual da coluna em listas permite criar gráficos rápidos, agrupar registros, configurar exibições e exportar dados.", hint: "Acessado ao clicar com botão direito no cabeçalho de uma coluna da lista." },
      { id: 21, domain: "Database Administration & CMDB", question: "Which ServiceNow products can be used to discover and populate the CMDB? (Choose two.)", options: ["Discovery", "IntegrationHub ETL", "Finder", "CMDB Plug-in", "CMDB Integration Dashboard"], answer: [0, 1], explanation: "O ServiceNow Discovery e o IntegrationHub ETL são as principais ferramentas oficiais para popular e atualizar o CMDB automaticamente.", hint: "Descobrimento de rede automático e ferramenta de ETL de integração." },
      { id: 22, domain: "Data Migration & Integration", question: "When using the Load Data and Transform Map process, what is the Mapping Assist used for?", options: ["Mapping fields using the Import Log", "Mapping fields using Transform History", "Mapping fields using an SLA", "Mapping fields using a Field Map"], answer: 3, explanation: "O Mapping Assist é a interface gráfica usada durante a criação do Transform Map para mapear manualmente os campos de origem e destino (Field Maps).", hint: "Ferramenta visual para associar campos de origem aos de destino." },
      { id: 23, domain: "Database Administration & CMDB", question: "Which one of the following statements describes the contents of the Configuration Management Database (CMDB)?", options: ["The CMDB contains data about tangible and intangible business assets", "The CMDB contains the Business Rules that direct the intangible, configurable assets used by a company", "The CMDB archives all Service Management PaaS equipment metadata and usage statistics", "The CMDB contains ITIL process data pertaining to configuration items"], answer: 0, explanation: "O CMDB armazena registros de Itens de Configuração (CIs), que englobam ativos tangíveis (ex: servidores, computadores) e intangíveis (ex: serviços, software).", hint: "Contém informações sobre ativos e componentes de negócios tangíveis e intangíveis." },
      { id: 24, domain: "User Interface & Navigation", question: "In what order should filter elements be specified?", options: ["Field, Operator, then Value", "Field, Operator, then Condition", "Operator, Condition, then Value", "Value, Operator, then Field"], answer: 0, explanation: "A estrutura de um filtro de lista segue sempre a sequência: Campo (Field) -> Operador (Operator) -> Valor (Value). Ex: [Estado] [é] [Em Aberto].", hint: "Sequência lógica de filtro: Campo, Operador e Valor." },
      { id: 25, domain: "Service Automation & Process Automation", question: "Which statement is true about business rules?", options: ["A business rule must run before a database action occurs", "A business rule can be a piece of Javascript", "A business rule must not run before a database action occurs", "A business rule monitors fields on a form"], answer: 1, explanation: "Business Rules são scripts do lado do servidor escritos em JavaScript que são executados quando registros são inseridos, atualizados ou excluídos.", hint: "Script executado no servidor em JavaScript." },
      { id: 26, domain: "Service Automation & Process Automation", question: "Which of the following are a type of client scripts supported in ServiceNow? (Choose four.)", options: ["onSubmit", "onUpdate", "onCellEdit", "onLoad", "onEdit", "onChange", "onSave"], answer: [0, 2, 3, 5], explanation: "Os quatro tipos suportados de Client Scripts no ServiceNow são: onLoad, onChange, onSubmit e onCellEdit.", hint: "Carregamento do formulário, alteração de campo, envio do formulário e edição direta na célula da lista." },
      { id: 27, domain: "Database Administration & CMDB", question: "Which type of tables may be extended by other tables, but do not extend another table?", options: ["Base Tables", "Core Tables", "Extended Tables", "Custom Tables"], answer: 0, explanation: "Base Tables (Tabelas Base) são tabelas que podem ser estendidas por outras (como a tabela `task`), mas não estendem nenhuma outra tabela.", hint: "Tabelas no nível mais raiz de uma hierarquia de herança." },
      { id: 28, domain: "Collaboration & Service Catalog", question: "Which of the following statement describes the purpose of an Order Guide?", options: ["Order Guides restrict the number of items in an order to only one item per request", "Order Guide provide a list of guidelines for Administrators on how to set up item variables", "Order Guide provide the ability to order multiple, related items as one request", "Order Guides take the user directly to the checkout without prompting for information"], answer: 2, explanation: "Um Order Guide permite agrupar e solicitar múltiplos itens relacionados em um único pedido de forma simplificada (ex: Onboarding de Novo Funcionário).", hint: "Permite solicitar múltiplos itens relacionados de uma só vez." },
      { id: 29, domain: "Collaboration & Service Catalog", question: "Which tool is used to have conversations with logged-in users in real-time?", options: ["Connect Chat", "Now Messenger", "User Presence", "Comments"], answer: 0, explanation: "O Connect Chat é a ferramenta de colaboração em tempo real que permite mensagens diretas entre usuários na plataforma.", hint: "Ferramenta clássica de chat em tempo real da plataforma." },
      { id: 30, domain: "Database Administration & CMDB", question: "Which of the following concepts are associated with the ServiceNow CMDB? (Choose four.)", options: ["Service Processes", "User Permissions", "Tables and Fields", "A Database", "The Dependency View"], answer: [0, 2, 3, 4], explanation: "O CMDB do ServiceNow é um banco de dados composto por tabelas e campos de CIs, associado a processos de serviço e visualizável via Dependency View.", hint: "Processos, Estrutura de tabelas/campos, Banco de dados e Visualizador de dependências." },
      { id: 31, domain: "User Interface & Navigation", question: "What is a formatter? Select one of the following.", options: ["A formatter allows you to configure applications on your instance", "A formatter is a form element used to display information that is not a field in the record", "A formatter allows you to populate fields automatically", "A formatter is a set of conditions applied to a table to help find and work with data"], answer: 1, explanation: "Um Formatter é um elemento de formulário usado para exibir informações dinâmicas que não correspondem a um campo direto da tabela (ex: Activity Stream, Approval Summarizer).", hint: "Exibe informações no formulário que não vêm de um campo único do registro." },
      { id: 32, domain: "User Interface & Navigation", question: "When searching using the App Navigator search field, what can be returned? (Choose four.)", options: ["Names of Applications and Modules", "Names of Modules", "Names of Applications", "Favorites"], answer: [0, 1, 2, 3], explanation: "O filtro do Application Navigator busca por nomes de aplicações, módulos e favoritos salvos do usuário.", hint: "Filtra aplicações, módulos e itens favoritados." },
      { id: 33, domain: "Database Administration & CMDB", question: "Which technique is used to get information from a series of referenced fields from different tables?", options: ["Table-Walking", "Sys_ID Pulling", "Dot-Walking", "Record-Hopping"], answer: 2, explanation: "Dot-Walking é a técnica de navegação através de campos de referência com ponto (`.`), permitindo acessar dados de tabelas relacionadas (ex: `assigned_to.manager.email`).", hint: "Navegar através de tabelas relacionadas utilizando sintaxe de pontos." },
      { id: 34, domain: "Database Administration & CMDB", question: "What is a schema map?", options: ["A schema map enables administrators to define records from specific tables as trouble sources for Configuration Items", "A schema map graphically organizes the visual task boards for the CMDB", "A schema map graphically displays the Configuration Items that support a business service", "A schema map displays the details of tables and their relationships in a visual manner, allowing administrators to view and easily access different parts of the database schema"], answer: 3, explanation: "O Schema Map exibe graficamente a estrutura das tabelas do banco de dados e todos os seus relacionamentos de herança e referência.", hint: "Visualizador gráfico do esquema e relacionamentos do banco de dados." },
      { id: 35, domain: "Core Configuration & Security", question: "Which one of the following statements best describes the purpose of an Update Set?", options: ["An Update Set allows administrators to group a series of changes into a named set and then move this set as a unit to other systems", "By default, an Update Set includes customizations, Business Rules, and homepages", "An Update Set is a group of customizations that is moved from Production to Development", "By default, the changes included in an Update Set are visible only in the instance to which they are applied"], answer: 0, explanation: "Um Update Set agrupa um conjunto de personalizações de configuração para que possam ser transferidas juntas entre instâncias (ex: de Dev para Teste/Prod).", hint: "Agrupa alterações de configuração para transporte entre instâncias." },
      { id: 36, domain: "User Interface & Navigation", question: "Which of the following can be customized through the Basic Configuration UI 16 module? (Choose three.)", options: ["Banner Image", "Record Number Format", "Browser Tab Title", "System Date Format", "Form Header Size"], answer: [0, 2, 4], explanation: "O módulo Basic Configuration UI16 permite alterar a imagem do banner, o título da aba do navegador e estilos de cabeçalho da interface.", hint: "Atributos visuais de branding e marca na interface clássica." },
      { id: 37, domain: "Core Configuration & Security", question: "What is the function of user impersonation?", options: ["Testing and visibility", "Activate verbose logging", "View custom perspectives", "Unlock Application master list"], answer: 0, explanation: "Personificar (Impersonate) um usuário permite que administradores vejam a plataforma exatamente como o usuário a vê, facilitando testes de permissão e suporte.", hint: "Testar a visão e acessos reais de outro usuário." },
      { id: 38, domain: "Database Administration & CMDB", question: "What information does the System Dictionary contain?", options: ["The human-readable labels and language settings", "The definition for each table and column", "The information on how tables relate to each other", "The language dictionary used for spell checking"], answer: 1, explanation: "O System Dictionary (`sys_dictionary`) contém as definições técnicas de todas as tabelas e campos/colunas do banco de dados.", hint: "Contém as definições de estrutura das tabelas e colunas." },
      { id: 39, domain: "User Interface & Navigation", question: "When working on a form, what is the difference between Insert and Update operations?", options: ["Insert creates a new record and Update saves changes, both remain on the form", "Insert creates a new record and Update saves changes, both exit the form", "Insert saves changes and exits the form, Update saves changes and remains on the form", "Insert saves changes and remains on the form, Update saves changes and exits the form"], answer: 1, explanation: "Tanto a ação 'Insert' (criar novo) quanto 'Update' (atualizar) salvam as alterações no banco de dados e fecham/saem do formulário retornando à lista.", hint: "Ambos salvam as alterações e fecham o formulário." },
      { id: 40, domain: "Service Automation & Process Automation", question: "How is the Event Log different from the Event Registry?", options: ["Event Log contains generated Events, the Event Registry is a table of Event definitions", "Event Log is formatted in the Log style, the Event Registry displays different fields", "Event Log lists Events that were triggered by integrations, the Event Registry lists the Events that were triggered during the day (24-hour period)", "Event Log is the same as the Event Registry"], answer: 0, explanation: "O Event Registry armazena as definições/regras de eventos válidos no sistema, enquanto o Event Log armazena o histórico dos eventos que foram realmente disparados.", hint: "Event Registry é o cadastro de regras, Event Log é o histórico de disparo." },
      { id: 41, domain: "Database Administration & CMDB", question: "What is a Dictionary Override?", options: ["A Dictionary Override is an incoming customer update in an Update Set which applies to the same objects as a newer local customer update", "A Dictionary Override is the addition, modification, or removal of anything that could have an effect on IT services", "A Dictionary Override is a task within a flow that requests an action before the flow can continue", "A Dictionary Override sets field properties in extended tables"], answer: 3, explanation: "O Dictionary Override permite alterar propriedades de um campo em uma tabela filha sem modificar o comportamento do campo na tabela pai (ex: tornar o campo `state` obrigatório apenas na tabela `incident`).", hint: "Sobrescreve propriedades de campos em tabelas estendidas/filhas." },
      { id: 42, domain: "Core Configuration & Security", question: "Which group of permissions is used to control Application and Module access?", options: ["Access Control Rules", "UI Policies", "Roles", "Assignment Rules"], answer: 2, explanation: "Aplicações e Módulos no menu de navegação têm seu acesso restrito através de papéis/funções (Roles) atribuídos aos usuários ou grupos.", hint: "Atribuição de Roles em cada aplicação/módulo." },
      { id: 43, domain: "Collaboration & Service Catalog", question: "What is a Record Producer?", options: ["A Record Producer is a type of Catalog Item that is used for Requests, not Services", "A Record Producer creates user records", "A Record Producer is a type of Catalog Item that provides easy ordering by bundling requests", "A Record Producer is a type of a Catalog Item that allows users to create task-based records from the Service Catalog"], answer: 3, explanation: "Um Record Producer é um item do Service Catalog com formulário simplificado que cria registros em tabelas do sistema (como Incident, Change Request).", hint: "Gera registros em tabelas de tarefas através do catálogo." },
      { id: 44, domain: "Collaboration & Service Catalog", question: "Create Incident, Password Reset, and Report outage: what do these services in the Service Catalog have in common?", options: ["They direct the user to a record producer", "They direct the user to a catalog property", "They direct the user to a catalog UI policy", "They direct the user to a catalog client script"], answer: 0, explanation: "Todos esses itens do catálogo fornecem formulários para criação direta de registros de tarefas e incidentes no sistema via Record Producers.", hint: "Todos utilizam Record Producers no catálogo de serviços." },
      { id: 45, domain: "Data Migration & Integration", question: "What is the Import Set Table?", options: ["A table where data will be placed, post-transformation", "A table that determines relationships", "A staging area for imported records", "A repository for Update Set information"], answer: 2, explanation: "A Import Set Table atua como uma área temporária de transição (staging area) onde os dados externos brutos são armazenados antes da transformação.", hint: "Área de armazenamento temporário (staging area) dos dados importados." },
      { id: 46, domain: "Data Migration & Integration", question: "What is a characteristic of importing data into ServiceNow?", options: ["An existing Transform Map can be used one time on the same import set", "Coalesce fields are used only after running Transform", "Any user can manage and set up import sets", "An existing Transform Map can be used multiple times on the same import set"], answer: 3, explanation: "Um Transform Map previamente configurado pode ser reutilizado várias vezes para processar diferentes importações de dados na mesma estrutura.", hint: "Um Transform Map pode ser reaproveitado em várias execuções." },
      { id: 47, domain: "Collaboration & Service Catalog", question: "What module in the Service Catalog application does an Administrator access to begin creating a new item?", options: ["Maintain Categories", "Maintain Items", "Content Items", "Items"], answer: 1, explanation: "O módulo 'Maintain Items' no aplicativo Service Catalog é onde administradores e catalog admins gerenciam e criam novos itens de catálogo.", hint: "Módulo 'Maintain Items'." },
      { id: 48, domain: "User Interface & Navigation", question: "Which of the following allows a user to edit field values in a list without opening the form?", options: ["Data Editor", "Edit Menu", "List Editor", "Form Designer"], answer: 2, explanation: "O List Editor permite que os usuários façam edições diretas e rápidas nos valores dos campos diretamente na visualização de lista.", hint: "Edição direta na célula da lista." },
      { id: 49, domain: "Collaboration & Service Catalog", question: "Which three Variable Types can be added to a Service Catalog Item?", options: ["True/False, Multiple Choice, and Ordered", "True/False, Checkbox, and Number List", "Number List, Single Line Text, and Reference", "Multiple Choice, Select Box, and Checkbox"], answer: 3, explanation: "Multiple Choice (múltipla escolha), Select Box (caixa de seleção) e Checkbox (caixa de verificação) são tipos oficiais de variáveis do catálogo.", hint: "Escolhas de múltipla seleção, seleção única e caixa de seleção." },
      { id: 50, domain: "Core Configuration & Security", question: "How are Workflows moved between instances?", options: ["Workflows are moved using Update Sets", "Workflows are moved using Transform Maps", "Workflows are moved using Application Sets", "Workflows cannot be moved between instances"], answer: 0, explanation: "Quando um Workflow é publicado no ServiceNow, ele é capturado automaticamente pelo Update Set ativo para ser migrado entre ambientes.", hint: "Workflows publicados são capturados em Update Sets." },
      { id: 51, domain: "Collaboration & Service Catalog", question: "The baseline Service Catalog homepage contains links to which of the following components?", options: ["Record Producers, Order Guides, and Catalog Items", "Order Guides, Item Variables, and flows", "Order Guides, Catalog Items, and flows", "Record Producers, Order Guides, and Item Variables"], answer: 0, explanation: "A página inicial padrão do catálogo de serviços dá acesso a Record Producers, Order Guides e Catalog Items.", hint: "Elementos principais visíveis na página inicial." },
      { id: 52, domain: "Database Administration & CMDB", question: "Which of the following statements is true when a new table is created by extending another table?", options: ["The new table archives the parent table and assumed its roles in the database", "The new table inherits all of the Business Rules, Client Scripts, and UI Policies of the parent table, but none of the existing fields", "The new table inherits all of the fields of the parent table and can also contain new fields unique to itself", "The new table inherits all of the fields, but does not inherit Access Control rules, Client Scripts, and UI Policies of the parent table"], answer: 2, explanation: "Uma tabela estendida (filha) herda todos os campos e scripts/regras da tabela pai, podendo adicionar campos exclusivos.", hint: "Herança completa de campos e scripts da tabela pai." },
      { id: 53, domain: "Core Configuration & Security", question: "Where can Admins check which release is running on an ServiceNow instance?", options: ["Memory Stats module", "Stats module", "System.upgraded table", "Transactions log"], answer: 1, explanation: "O módulo 'Stats' (`stats.do`) mostra os detalhes do sistema, build e versão da versão ativa da instância.", hint: "Módulo Stats / stats.do." },
      { id: 54, domain: "Collaboration & Service Catalog", question: "A knowledge article must be which of the following states to display to a user?", options: ["Published", "Drafted", "Retired", "Reviewed"], answer: 0, explanation: "Apenas artigos no estado 'Published' (Publicado) estão visíveis para leitura pública/usuários finais.", hint: "Estado ativo de publicação." },
      { id: 55, domain: "Collaboration & Service Catalog", question: "What is the name of the conversational bot platform that provides assistance to help users obtain information, make decisions, and perform common tasks?", options: ["Answer Agent", "Live Feed", "Virtual Agent", "Connect Chat"], answer: 2, explanation: "O Virtual Agent é a plataforma de chatbot conversacional do ServiceNow.", hint: "Agente Virtual conversacional." },
      { id: 56, domain: "User Interface & Navigation", question: "What is the purpose of a Related List?", options: ["To create a one-to-many relationship", "To dot-walk to a core table", "To present related fields", "To present related records"], answer: 3, explanation: "Related Lists mostram listas de registros de outras tabelas que possuem relacionamento com o registro atual.", hint: "Exibir registros relacionados no formulário." },
      { id: 57, domain: "Service Automation & Process Automation", question: "Which one of the following statements describes the purpose of a Service Catalog flow?", options: ["A Service Catalog flow generates three basic components: item variable types, tasks, and approvals", "Although a Service Catalog flow cannot send notifications, the flow drives complex fulfillment processes", "A Service Catalog flow is used to drive complex fulfillment processes and sends notifications to defined users or groups", "A Service Catalog flow generates three basic components: item variable types, tasks, and notifications"], answer: 2, explanation: "Fluxos de catálogo orquestram a execução do atendimento do pedido, envio de notificações e aprovações.", hint: "Gerencia processos complexos de atendimento e notificações." },
      { id: 58, domain: "Database Administration & CMDB", question: "Which term best describes something that is created, has worked performed upon it, and is eventually moved to a state of closed?", options: ["report", "flow", "event", "task"], answer: 3, explanation: "Qualquer item de trabalho que é criado, trabalhado e fechado é uma Tarefa (Task).", hint: "Unidade básica de trabalho estendida por Incidentes e Mudanças." },
      { id: 59, domain: "Core Configuration & Security", question: "Which are valid ServiceNow User Authentication Methods? (Choose three.)", options: ["XML feed", "Local database", "LDAP", "SSO", "FTP authentication"], answer: [1, 2, 3], explanation: "ServiceNow suporta autenticação via Banco Local, integração com LDAP e Single Sign-On (SSO / SAML).", hint: "Banco de dados local, LDAP e SSO." },
      { id: 60, domain: "Core Configuration & Security", question: "Access Control rules may be defined with which of the following permission requirements? (Choose three.)", options: ["Roles", "Conditional Expressions", "Assignment Rules", "Scripts", "User Criteria", "Groups"], answer: [0, 1, 3], explanation: "Regras de Access Control (ACL) podem exigir Papéis (Roles), Expressões Condicionais e Scripts para conceder acesso.", hint: "Roles, Condição e Script no formulário da ACL." },
      { id: 61, domain: "User Interface & Navigation", question: "Which section of the ServiceNow UI allows you to perform a global search?", options: ["Application Navigator", "Banner frame", "List pane", "Content frame"], answer: 1, explanation: "A busca global fica localizada no quadro do cabeçalho superior (Banner frame).", hint: "Localizado no topo/banner da interface." },
      { id: 62, domain: "User Interface & Navigation", question: "How do you make a list filter available to everyone?", options: ["Make active, assign a name, and save", "Assign a group, set visibility, and save", "Assign a name, set visibility, and save", "Make active, set visibility, and save"], answer: 2, explanation: "Para salvar um filtro visível para todos os usuários, você deve nomeá-lo, ajustar a visibilidade para 'Everyone' e salvar.", hint: "Nomear, configurar visibilidade e salvar." },
      { id: 63, domain: "User Interface & Navigation", question: "What would NOT appear in the Application Navigator if 'service' is typed into the filter field?", options: ["Configuration > Business Services", "Self-Service > Knowledge", "Service Portal > Widgets", "Incident > Assigned to me"], answer: 3, explanation: "O módulo 'Assigned to me' sob Incident não contém a palavra 'service' em seu título.", hint: "O título deste módulo não possui a palavra 'service'." },
      { id: 64, domain: "User Interface & Navigation", question: "Which of the following is used to categorize, flag, and locate records?", options: ["Search", "Favorites", "Tags", "Bookmarks"], answer: 2, explanation: "Etiquetas (Tags) permitem aos usuários categorizar e filtrar registros pessoais ou compartilhados no sistema.", hint: "Etiquetas personalizadas para marcar registros." },
      { id: 65, domain: "User Interface & Navigation", question: "Which tool should be used to populate commonly used fields in a form?", options: ["Template", "Reference Qualifier", "Formatter", "Assignment Rule"], answer: 0, explanation: "Modelos (Templates) preenchem automaticamente conjuntos de campos com valores pré-definidos para agilizar o preenchimento.", hint: "Modelo reutilizável para autopreenchimento de formulários." },
      { id: 66, domain: "Core Configuration & Security", question: "How is a group defined in ServiceNow?", options: ["A group is one record stored in the Group Type [sys_user_group_type] table", "A group is one record stored in the Group [sys_user_group] table", "A group defines a set of users that share the same location", "A group defines a set of users that share the same job title"], answer: 1, explanation: "Um grupo no ServiceNow é representado por um registro na tabela `sys_user_group`.", hint: "Tabela `sys_user_group`." },
      { id: 67, domain: "Core Configuration & Security", question: "What is a role in ServiceNow?", options: ["A role is one record in the Role [user_sys_role] table", "A role is a set of modules for a particular application", "A role is one record in the Role [sys_user_role] table", "A role is a persona used in Live Feed Chat"], answer: 2, explanation: "Um papel/função de permissão é armazenado na tabela `sys_user_role`.", hint: "Tabela `sys_user_role`." },
      { id: 68, domain: "Service Automation & Process Automation", question: "What is a Notification?", options: ["A new Knowledge article created by a Business Rule", "A tool for alerting users that events that concern them have occurred", "A message through Connect related to a Change Request", "An email file attachment"], answer: 1, explanation: "Uma Notificação é uma ferramenta para alertar usuários por e-mail ou SMS sobre eventos relevantes no sistema.", hint: "Alerta aos usuários sobre atualizações e eventos." },
      { id: 69, domain: "User Interface & Navigation", question: "Which one of the following is NOT a type of Visual Task Board?", options: ["Flexible", "Freeform", "Feature", "Guided boards"], answer: 2, explanation: "Os três tipos reais de quadros Kanban (Visual Task Boards) são Freeform, Flexible e Guided. 'Feature' não existe.", hint: "Os 3 tipos são Freeform, Flexible e Guided." },
      { id: 70, domain: "Core Configuration & Security", question: "What is (are) best practice(s) regarding users/groups/roles? (Choose two.)", options: ["You should never assign roles to groups.", "You should assign roles to users.", "You should add users to groups.", "You should assign roles to groups."], answer: [2, 3], explanation: "Boa prática de governança: atribua papéis/roles para grupos e adicione os usuários dentro desses grupos.", hint: "Roles vão em Grupos, Usuários vão em Grupos." },
      { id: 71, domain: "Service Automation & Process Automation", question: "What are two ways to generate an Event? (Choose two.)", options: ["Business Rule", "Workflow", "Log entry", "Knowledge article publication"], answer: [0, 1], explanation: "Eventos podem ser disparados através de scripts de servidor em Business Rules ou etapas em Workflows/Flows.", hint: "Business Rules e Workflows geram eventos no sistema." },
      { id: 72, domain: "Database Administration & CMDB", question: "Which core table in the ServiceNow platform provides a series of standard fields used on each of the tables that extend it?", options: ["Task [task]", "Assignment [assignment]", "Service [service]", "Workflow [workflow]"], answer: 0, explanation: "A tabela `task` é a tabela pai fundamental de onde Incidentes, Problemas, Mudanças e Tarefas herdam campos comuns.", hint: "Tabela `task`." },
      { id: 73, domain: "Database Administration & CMDB", question: "Which of the following statements describes how data is organized in a table?", options: ["A column is a field in the database and a record is one user", "A column is one field and a record is one row", "A column is one field and a record is one column", "A column contains data from one user and a record is one set of fields"], answer: 1, explanation: "Em um banco de dados relacional, uma Coluna representa um Campo e um Registro representa uma Linha (Row).", hint: "Coluna = Campo, Registro = Linha." },
      { id: 74, domain: "Database Administration & CMDB", question: "What is a sys_id?", options: ["Unique 32-character identifier that is assigned to every record", "A client-side Business Rule", "A server-side Business Rule", "Unique 64-character identifier that is assigned to every record"], answer: 0, explanation: "O `sys_id` é o identificador único universal de 32 caracteres gerado automaticamente para cada registro no ServiceNow.", hint: "Identificador único de 32 caracteres (GUID)." },
      { id: 75, domain: "Database Administration & CMDB", question: "When creating a global custom table named 'abc', what is the table name that is automatically assigned by the platform?", options: ["snc_abc", "abc", "u_abc", "sys_abc"], answer: 2, explanation: "Tabelas customizadas criadas no escopo Global recebem automaticamente o prefixo `u_` (ex: `u_abc`).", hint: "Prefixo `u_` em tabelas customizadas no escopo Global." },
      { id: 76, domain: "Core Configuration & Security", question: "Access Control rules may provide access security for which of the following database objects?", options: ["For a specific role, group, or user", "For a specific row, column, or table", "For specific groups", "For a specific CMDB Configuration item"], answer: 1, explanation: "As regras de segurança ACL controlam acesso nos níveis de linha (registro), coluna (campo) ou tabela inteira.", hint: "Segurança de linha (row), coluna (column) ou tabela (table)." },
      { id: 77, domain: "Data Migration & Integration", question: "What is the primary application used to load data into ServiceNow?", options: ["Service Level Management", "Configuration", "System Import Sets", "System Update Sets"], answer: 2, explanation: "O aplicativo 'System Import Sets' é a ferramenta nativa para importar dados de fontes externas.", hint: "System Import Sets." },
      { id: 78, domain: "Data Migration & Integration", question: "Which of the following steps can be used to import new data into ServiceNow from a spreadsheet?", options: ["Select Data Source, Schedule Transform", "Load Data, Create Transform Map, Run Transform", "Define Data Source, Select Transform Map, Run Transform", "Select Import Set, Select Transform Map, Run Transform"], answer: 1, explanation: "A sequência correta de importação é: Carregar Dados (Load Data) -> Criar Transform Map -> Executar Transformação (Run Transform).", hint: "Load Data -> Create Transform Map -> Run Transform." },
      { id: 79, domain: "Database Administration & CMDB", question: "Which tool is used for creating dependencies between configuration items in the CMDB?", options: ["CI Relationship Editor", "CMDB Builder", "CI Service Manager", "CI Class Manager"], answer: 0, explanation: "O CI Relationship Editor é a ferramenta visual para definir novos relacionamentos de dependência entre CIs.", hint: "Editor de relacionamento de CIs." },
      { id: 80, domain: "Core Configuration & Security", question: "What is the difference between a UI Policy and Data Policy?", options: ["Data Policies run when data is entered through the form, while UI Policies run on import", "Data Policies can be converted into UI Policies, but UI Policies cannot", "Data Policies run regardless of how data is entered into ServiceNow, while UI Policies are used for form interactions", "Data Policies run only after UI Policies run successfully"], answer: 2, explanation: "Data Policies garantem regras de dados no nível de servidor (importações, web services e formulários), enquanto UI Policies agem no navegador.", hint: "Data Policy roda no servidor para qualquer entrada de dados; UI Policy roda no navegador." },
      { id: 81, domain: "Core Configuration & Security", question: "Which one of the following is an accurate list of changes that are captured in an Update Set?", options: ["Changes made to: tables, forms, schedules, and client scripts", "Changes made to: tables, forms, Business Rules, and data records", "Changes made to: tables, forms, groups, and configuration items (CIs)", "Changes made to: table, forms, views, and fields"], answer: 3, explanation: "Update Sets capturam alterações de configuração/customização (tabelas, formulários, visões, campos, scripts), e NÃO registros de dados normais.", hint: "Captura estrutura e personalizações de interface, não dados." },
      { id: 82, domain: "Core Configuration & Security", question: "What are the steps to retrieve an Update Set?", options: ["Verify Update Set is Complete, Retrieve, Preview, Apply", "Verify Update Set is Complete, Test Connection, Apply", "Verify Update Set is Complete, Test Connection, Commit", "Verify Update Set is Complete, Retrieve, Preview, Commit"], answer: 3, explanation: "Fluxo de transferência de Update Sets: Verificar Completo na Origem -> Buscar (Retrieve) -> Previsualizar (Preview) -> Aplicar (Commit).", hint: "Retrieve -> Preview -> Commit." },
      { id: 83, domain: "Service Automation & Process Automation", question: "IntegrationHub enables execution of third-party APIs as a part of a flow. These integrations are referred to as", options: ["an action", "a spoke", "a connection", "an integration step"], answer: 1, explanation: "Módulos de integração pré-construídos para sistemas terceiros no IntegrationHub são chamados de 'Spokes'.", hint: "Pacotes de integração chamados 'Spokes'." },
      { id: 84, domain: "Core Configuration & Security", question: "Which of the following protects applications by identifying and restricting access to available files and data?", options: ["Application Configuration", "Verbose Log", "Access Control Rules", "Application Scope"], answer: 3, explanation: "O Escopo de Aplicação (Application Scope) isola e protege os arquivos da aplicação de acessos não autorizados por outros aplicativos.", hint: "Escopo de Aplicação (Application Scope)." },
      { id: 85, domain: "Core Configuration & Security", question: "Which one statement correctly describes Access Control rule evaluation?", options: ["Table access rules are evaluated from the general to the specific", "If more than one rule applies to a record, the older rule is evaluated first", "If a row level rule and a field level rule exist, both rules must be true before an operation is allowed", "The role with the most permissions evaluates the rules first."], answer: 2, explanation: "Se existirem regras no nível de linha (registro) e no nível de campo, AMBAS as condições de ACL precisam ser aceitas.", hint: "Tanto a regra da linha quanto a do campo devem ser satisfeitas." },
      { id: 86, domain: "Database Administration & CMDB", question: "What resource provides a standard framework across ServiceNow products to support service level reporting and configuration strategy?", options: ["Common Services Data Model (CSDM)", "Information Technology Service Management (ITSM)", "Configuration Management Database (CMDB)", "Information Technology Infrastructure Library (ITIL)"], answer: 0, explanation: "O CSDM (Common Services Data Model) é o modelo arquitetural padrão que conecta os serviços de TI ao CMDB.", hint: "Modelo CSDM." },
      { id: 87, domain: "User Interface & Navigation", question: "An IT manager cannot see tasks assigned to their teams on 'My Groups Work'. What could explain this?", options: ["The Service Desk > My Groups Work list shows active work tasks that are not yet assigned.", "The manager does not have the itil role.", "The manager is not a member of the Service Desk group.", "The manager is not a member of the Network and Hardware groups."], answer: 3, explanation: "Para ver chamados na lista 'My Groups Work', o usuário logado precisa ser membro ativo desses grupos.", hint: "O gerente precisa pertencer aos grupos para visualizar o trabalho do grupo." },
      { id: 88, domain: "Service Automation & Process Automation", question: "What do you need to do before you can use an Application-based trigger in your flow?", options: ["Activate application trigger spoke", "Activate trigger security rules", "Activate application spoke, and plug-ins as needed", "Assign Application trigger role to SME"], answer: 2, explanation: "Para usar gatilhos baseados em aplicativos específicos no Flow Designer, é necessário ativar o Spoke e plugins correspondentes.", hint: "Ativar o Spoke da aplicação e seus plugins." },
      { id: 89, domain: "User Interface & Navigation", question: "The ServiceNow platform includes which types of interfaces? (Choose three.)", options: ["Now Mobile Apps", "Agent Control Center", "Back Office Dashboard", "Service Portals", "Now Platform User Interfaces", "Field Service Taskboard"], answer: [0, 3, 4], explanation: "As três interfaces nativas de usuário são os aplicativos Now Mobile, os Portais de Serviço (Service Portals) e a UI da Plataforma.", hint: "Mobile Apps, Service Portals e UI da Plataforma." },
      { id: 90, domain: "Core Configuration & Security", question: "Which of the following are not included in an Update Set, by default? (Choose four.)", options: ["Homepages", "Data", "Published Workflows", "Business Rules", "Schedules", "Database changes", "Related Lists", "Report Definitions", "Scheduled Jobs"], answer: [0, 1, 4, 8], explanation: "Por padrão, Homepages, Dados de tabela, Agendamentos (Schedules) e Jobs Agendados (Scheduled Jobs) NÃO são capturados por Update Sets.", hint: "Homepages, Registros de Dados, Schedules e Scheduled Jobs." },
      { id: 91, domain: "User Interface & Navigation", question: "Where can you add a new field to a form? (Choose two.)", options: ["Select Fields and Columns module", "Right click on form header, select Configure > Form Layout", "Click on context menu, select Configure > Form Designer", "Select Field Class Manager module"], answer: [1, 2], explanation: "Novos campos podem ser adicionados ao formulário utilizando o Form Layout ou o Form Designer.", hint: "Configure > Form Layout e Configure > Form Designer." },
      { id: 92, domain: "Database Administration & CMDB", question: "Which ServiceNow resource is a framework that ensures the data your application requires maps correctly to CMDB tables?", options: ["Common Service Data Model (CSDM)", "Service Mapping Utility (SMU)", "Service Schema Map (SSM)", "CMDB Class Manager"], answer: 0, explanation: "O CSDM é o framework orientador de padronização do mapeamento de dados para as tabelas do CMDB.", hint: "Common Service Data Model (CSDM)." },
      { id: 93, domain: "Core Configuration & Security", question: "What do you activate when you want to add applications or functionality within your instance?", options: ["App Package", "Updated Pack", "Patch", "Plugin", "App Updated Set"], answer: 3, explanation: "Plugins são pacotes modulares de funcionalidades que podem ser ativados para adicionar novos recursos à instância.", hint: "Ativação de Plugin." },
      { id: 94, domain: "Database Administration & CMDB", question: "What field contains a record's 32-character, unique identifier?", options: ["sn_rec_id", "rec_id", "u_id", "sys_id"], answer: 3, explanation: "O campo `sys_id` armazena a chave primária única de 32 caracteres hexadecimais de cada registro.", hint: "Campo `sys_id`." },
      { id: 95, domain: "Collaboration & Service Catalog", question: "How would you ensure that only first line workers (non-managers) can submit a specific Catalog Item?", options: ["Create Record Producer and use Available For list with role", "Create Catalog Item and use the Not Available list to specify the Manager Group", "Create Catalog Item and use the Available For list to specify ITIL role", "Create Order Guide and use User Criteria list"], answer: 1, explanation: "Você pode restringir o acesso utilizando a lista 'Not Available' (User Criteria) no item de catálogo para o grupo de Gerentes.", hint: "Utilizar a aba/lista 'Not Available' para bloquear os gerentes." },
      { id: 96, domain: "Core Configuration & Security", question: "What is used frequently to move customizations from one instance to another?", options: ["Update Sets", "Code Sets", "Update Packs", "Configuration Logs"], answer: 0, explanation: "Update Sets são o mecanismo padrão para transportar customizações de ambiente de desenvolvimento para teste e produção.", hint: "Update Sets." },
      { id: 97, domain: "User Interface & Navigation", question: "What icon do you use to change the label on a Favorite?", options: ["Clock", "Hamburger", "Pencil", "Three dots"], answer: 2, explanation: "O ícone de Lápis (Edit/Pencil) na aba de Favoritos permite editar o nome, ícone e cor do atalho.", hint: "Ícone de Lápis." },
      { id: 98, domain: "Service Automation & Process Automation", question: "What needs to be specified, when creating a Business Rule? (Choose four.)", options: ["UI action", "Table", "Fields to update", "Who can run", "Script to run", "Application scope", "Update set", "Timing", "Condition to evaluate"], answer: [1, 4, 7, 8], explanation: "Para definir uma Business Rule é necessário informar: Tabela, Momento de Execução (Timing), Condições e o Script/Ação executado.", hint: "Table, Script, Timing (When), e Condition." },
      { id: 99, domain: "Service Automation & Process Automation", question: "What feature can track the amount of time that a task has been open, to ensure that tasks are completed within an allotted time?", options: ["Task Escalation Clock", "Service Level Agreements", "Inactivity Monitor", "Response Time Clock"], answer: 1, explanation: "Os SLAs (Service Level Agreements) monitoram o tempo decorrido e prazos de resolução de tarefas na plataforma.", hint: "SLAs." },
      { id: 100, domain: "User Interface & Navigation", question: "What is a quick way to create a report from a list view?", options: ["Click on filter breadcrumb, drag and drop on Report > Create New", "Click Funnel, define filter conditions, click Create Report", "Click Context Menu, select Create Report", "Apply filter, right click on column header, select Bar Chart or Pie Chart"], answer: 3, explanation: "Clicar com o botão direito no cabeçalho de uma coluna permite gerar relatórios gráficos instantâneos (como Bar Chart).", hint: "Botão direito no cabeçalho da coluna > Gráficos (Bar / Pie Chart)." },
      { id: 101, domain: "Data Migration & Integration", question: "What import utility do you use when the field names on the import set match the name of the fields on the Target table?", options: ["Schema Mapping", "Automatic Mapping", "Mapping Assist", "Mapping Dashboard"], answer: 1, explanation: "Quando os nomes das colunas de origem coincidem com os nomes dos campos da tabela destino, usa-se a funcionalidade de Auto Mapping (Automatic Mapping).", hint: "Automatic Mapping." },
      { id: 102, domain: "Collaboration & Service Catalog", question: "As an IT employee what interface would you use, if you wanted to browse internal IT documentation, like troubleshooting scripts and FAQs?", options: ["Knowledge", "ServiceNow Wiki", "Knowledge Now", "SharePoint"], answer: 0, explanation: "O módulo Knowledge (Base de Conhecimento) centraliza artigos técnicos, documentações e FAQs.", hint: "Knowledge / Base de Conhecimento." },
      { id: 103, domain: "User Interface & Navigation", question: "A new Service Desk employee complains that the create dates and times are incorrect on their Incident list. What would you suggest to fix this issue?", options: ["Have them clear their cache.", "Have them use the gear icon to set the employee's time zone.", "Recommend they use Chrome, instead of Explorer.", "Use system properties to correct instance time zone."], answer: 1, explanation: "O fuso horário de exibição do usuário pode ser ajustado individualmente através das preferências do sistema (ícone de engrenagem no cabeçalho).", hint: "Ícone de Engrenagem (System Settings) > Time Zone." },
      { id: 104, domain: "Core Configuration & Security", question: "What are three security modules often used by the System Administrator? (Choose three.)", options: ["System Properties > Security", "Utilities > Migrate Security", "System Security > Security", "Self-Service > My Access", "System Security > Access Control (ACL)", "Password Management > Security Questions", "System Security > High Security Settings"], answer: [0, 4, 6], explanation: "Os principais módulos de administração de segurança são: System Properties > Security, System Security > Access Control (ACL) e High Security Settings.", hint: "Properties Security, ACL e High Security Settings." },
      { id: 105, domain: "Collaboration & Service Catalog", question: "When testing a catalog item, having a manager approval flows, which of these best practices would you follow? (Choose three.)", options: ["Make sure the latest flows are activated.", "Use instance Incognito setting.", "Impersonate the requester to ensure the form works.", "Make sure the requester's user record has a manager specified.", "Create Testing Update Set.", "Use Admin account."], answer: [0, 2, 3], explanation: "Boas práticas de teste: garantir que o fluxo está ativo, personificar o solicitante e certificar-se de que o campo Manager do usuário solicitante está preenchido no cadastro.", hint: "Fluxo Ativo, Impersonate Requester e Manager cadastrado." },
      { id: 106, domain: "User Interface & Navigation", question: "What is a no-code approach to control the mandatory or read-only state of a form field?", options: ["UI Action", "Client Script", "UI Script", "UI Rule", "UI Policy"], answer: 4, explanation: "UI Policy permite tornar campos obrigatórios, somente leitura ou visíveis de forma condicional sem escrever código.", hint: "UI Policy." },
      { id: 107, domain: "Core Configuration & Security", question: "When moving multiple update sets at one time, what might you do to facilitate the move?", options: ["Batch", "Verify", "Test", "Preview"], answer: 0, explanation: "O agrupamento em Lote (Batching) de Update Sets permite organizar e mover conjuntos pai/filhos de alterações juntos.", hint: "Batch (Lote)." },
      { id: 108, domain: "Core Configuration & Security", question: "What is specified in an Access Control rule?", options: ["Groups, Conditional Expressions and Workflows", "Table Schema, CRUD, and User Authentication", "Object and Operation being secured; Permissions required to access the object", "security_admin"], answer: 2, explanation: "Uma ACL especifica o Objeto (tabela/campo), a Operação (read, write, create, delete) e as Permissões exigidas (roles, condições e scripts).", hint: "Objeto, Operação e Permissões." },
      { id: 109, domain: "User Interface & Navigation", question: "Which icon would you double click, to expand and collapse the list of all Applications and Modules?", options: ["Star", "Clock", "Application", "Funnel"], answer: 2, explanation: "Na interface clássica, dar duplo clique na aba/ícone de Aplicações expande ou recolhe todos os menus.", hint: "Ícone de Aplicação (Application)." },
      { id: 110, domain: "Database Administration & CMDB", question: "What do you call any component that needs to be managed in order to deliver services?", options: ["CSDM Items", "CMDB", "Configuration item", "Service Offerings", "Asset"], answer: 2, explanation: "Qualquer componente de infraestrutura ou serviço gerenciado no CMDB é um Item de Configuração (CI).", hint: "Configuration Item (CI)." },
      { id: 111, domain: "Collaboration & Service Catalog", question: "A new service catalog item should only be visible to managers inside the HR Department. What method would you use?", options: ["Specify Dept_Mgr role on content block", "Add Department Manager group to the catalog item's user criteria", "Add Department Manager group to ACL", "Only publish item in HR catalog"], answer: 1, explanation: "User Criteria (Critérios de Usuário) é a funcionalidade padrão para controlar visibilidade de itens de catálogo por departamento, grupo ou papel.", hint: "User Criteria." },
      { id: 112, domain: "User Interface & Navigation", question: "To filter records where State is Closed AND Assignment Group is Network, what should the user do in the condition builder?", options: ["Define the first condition; click AND button; define second condition; click Run", "Define first condition; click AND button; press enter", "Define first condition; click OR button", "Define first condition; click > icon"], answer: 0, explanation: "Para adicionar uma condição cumulativa, usa-se o botão AND entre as cláusulas e em seguida clica-se em Run.", hint: "Botão AND -> Run." },
      { id: 113, domain: "Core Configuration & Security", question: "Which Access Control rule is required to allow a user to edit the Major Incident field on the Incident table?", options: ["Incident.Major Incident", "incident->major_incident", "incident<=>major_incident", "incident major_incident", "incident.major_incident"], answer: 4, explanation: "A sintaxe de nome de objeto na ACL para um campo específico é `nome_tabela.nome_campo` (ex: `incident.major_incident`).", hint: "incident.major_incident." },
      { id: 114, domain: "Collaboration & Service Catalog", question: "Two departments need the exact same Event Room Set Up catalog item in their respective catalogs. What do you do?", options: ["Create two separate catalog items", "Create one Catalog Item for Event Room Set Up; then publish to both Catalogs", "Create one Catalog Item in Parent Catalog", "Use ACLs"], answer: 1, explanation: "Um único Catalog Item pode ser vinculado e publicado em múltiplos catálogos de serviços simultaneamente.", hint: "Um único item publicado em ambos os catálogos." },
      { id: 115, domain: "Core Configuration & Security", question: "After finishing your work on High Security Settings, what do you do to return to normal admin security levels?", options: ["Select Normal role", "Log out and back in", "Use System Administration module", "Select Global Update Set"], answer: 1, explanation: "Privilégios elevados com o papel `security_admin` expiram na sessão; fazer logout e login restaura a sessão normal.", hint: "Fazer Logout e Login novamente." },
      { id: 116, domain: "Database Administration & CMDB", question: "What type of field allows you to look up values from one other table?", options: ["Reference", "Verify", "Options", "Selections"], answer: 0, explanation: "Um campo do tipo Reference armazena um ponteiro para um registro em outra tabela específica.", hint: "Campo do tipo Reference." },
      { id: 117, domain: "Service Automation & Process Automation", question: "Which module would you use to create a new automation of business logic such as approvals, tasks, and notifications?", options: ["Process Automation > Flow Designer", "Process Automation > Flow Administration", "Process Automation > Workflow Editor"], answer: 0, explanation: "O Flow Designer (Process Automation > Flow Designer) é a ferramenta moderna sem código para criar automações de processos.", hint: "Process Automation > Flow Designer." },
      { id: 118, domain: "User Interface & Navigation", question: "A department manager asks an analyst to build some reports. Where do you recommend the analyst start?", options: ["Report Dashboard > Create New", "Reports > Getting Started", "Performance Analytics > Reports", "Reports > Create New"], answer: 3, explanation: "Para criar relatórios, navegue diretamente no módulo oficial Reports > Create New.", hint: "Reports > Create New." },
      { id: 119, domain: "Core Configuration & Security", question: "What are the steps for applying an update set to an instance?", options: ["Retrieve, Preview, Commit", "Specify, Transform, Apply", "Retrieve, Assess, Apply"], answer: 0, explanation: "Os passos para aplicar um Update Set são: Buscar (Retrieve) -> Previsualizar (Preview) -> Confirmar/Aplicar (Commit).", hint: "Retrieve, Preview, Commit." },
      { id: 120, domain: "Data Migration & Integration", question: "When importing spreadsheet data into ServiceNow, in which step does the data get written to the receiving table?", options: ["Run Transform", "Run Import", "Import Dataset", "Execute Transform"], answer: 0, explanation: "A gravação final na tabela destino ocorre quando você clica em Run Transform.", hint: "Run Transform." },
      { id: 121, domain: "User Interface & Navigation", question: "What would you do, on a list, if you wanted to show the records in groups, based on the column category? (Choose two.)", options: ["On list Context Menu, select Group By > Category", "On Filter Menu, select Group By", "Click Group On icon", "On Category column title, click Context menu > Group By Category"], answer: [0, 3], explanation: "O agrupamento pode ser acionado no menu de contexto da lista ou clicando com botão direito no cabeçalho da coluna específica.", hint: "Group By no menu da lista ou no cabeçalho da coluna." },
      { id: 122, domain: "Collaboration & Service Catalog", question: "Which collaboration tool is available from the banner, using the bubble icon?", options: ["Now Messenger", "Agent Chat", "Connect Chat", "Collaborate Now"], answer: 2, explanation: "O ícone de balão de conversa na barra superior abre a barra lateral do Connect Chat.", hint: "Connect Chat." },
      { id: 123, domain: "Collaboration & Service Catalog", question: "On the knowledge base record, which tab would you use to define which users are not able to write articles to the knowledge base?", options: ["Can Contribute", "Cannot Author", "Cannot Contribute", "Cannot Write"], answer: 2, explanation: "A guia 'Cannot Contribute' restringe quais usuários/grupos não possuem permissão de criar ou editar artigos na base.", hint: "Cannot Contribute." },
      { id: 124, domain: "User Interface & Navigation", question: "Which features allow you to update multiple records at one time? (Choose two.)", options: ["List Editor", "Field Update Action", "Bulk Record Update", "Data Remediation Dashboard", "Update Selected Action"], answer: [0, 4], explanation: "Para atualizar múltiplos registros juntos: utilize o List Editor selecionando células ou a opção 'Update Selected' no menu de contexto.", hint: "List Editor e Update Selected." },
      { id: 125, domain: "Collaboration & Service Catalog", question: "Categories in the knowledge base, by default, can be created and edited by which knowledge workers? (Choose two.)", options: ["Knowledge Authors", "Knowledge Contributors", "Knowledge Controller", "Knowledge Managers"], answer: [1, 3], explanation: "Knowledge Managers e usuários listados em Knowledge Contributors possuem autorização para gerenciar categorias na base de conhecimento.", hint: "Knowledge Contributors e Knowledge Managers." },
      { id: 126, domain: "User Interface & Navigation", question: "Which collaboration tool opens a sidebar and allows you to create new conversations with other ServiceNow users?", options: ["Skype Now", "Collaborate Now", "Agent Messenger", "Agent Chat", "Connect Chat"], answer: 4, explanation: "Connect Chat é a ferramenta clássica de colaboração que abre a barra lateral na interface para conversas entre usuários.", hint: "Connect Chat." },
      { id: 127, domain: "Database Administration & CMDB", question: "What module would you use if you wanted to view a list of all of the fields on the Incident table? (Choose two.)", options: ["Tables & Columns", "Dictionary", "Data Class Manager", "Dictionary Dashboard"], answer: [0, 1], explanation: "Pode-se inspecionar a lista de todos os campos de uma tabela usando o módulo 'Tables & Columns' ou o 'System Dictionary'.", hint: "Tables & Columns e System Dictionary." },
      { id: 128, domain: "Service Automation & Process Automation", question: "What component causes a flow to run after a record has been created or updated?", options: ["Date-based trigger", "On-change trigger", "Record-based trigger", "Application-based trigger"], answer: 2, explanation: "Gatillhos baseados em registro (Record-based trigger) disparam fluxos quando um registro é criado, atualizado ou excluído.", hint: "Record-based trigger." },
      { id: 129, domain: "Database Administration & CMDB", question: "What type of field is Boolean and appears as a check box?", options: ["Yes/No", "True/False", "On/Off", "Binary"], answer: 1, explanation: "Campos do tipo True/False no ServiceNow são campos booleanos exibidos visualmente como caixas de seleção (checkbox).", hint: "Tipo True/False." },
      { id: 130, domain: "Collaboration & Service Catalog", question: "Which module is used to access the knowledge bases which are available to you?", options: ["Knowledge > Home", "Self Service > Knowledge", "Knowledge > All"], answer: 1, explanation: "Self-Service > Knowledge é o ponto de entrada principal no menu de navegação para acessar artigos de conhecimento.", hint: "Self-Service > Knowledge." },
      { id: 131, domain: "Core Configuration & Security", question: "To make Incident numbers read-only for all users and Short Description mandatory across all applications on Insert, what type of policy is required?", options: ["Data Quality Policy", "Dictionary Design Policy", "UI Data Policy", "Data Policy"], answer: 3, explanation: "Como a regra deve valer no banco para todas as entradas e aplicações (não apenas formulário da UI), deve ser criada uma Data Policy.", hint: "Data Policy." },
      { id: 132, domain: "Core Configuration & Security", question: "What type of user (persona) has clearly defined paths and workflows in the platform and have one or more roles (ie itil and approver_user)?", options: ["Workflow User", "Request Fulfiller", "ITSM User", "Process User"], answer: 3, explanation: "Usuários de Processo (Process Users) são aqueles que possuem papéis/funções de trabalho (ex: `itil`) para atender e trabalhar em tarefas.", hint: "Process User." },
      { id: 133, domain: "User Interface & Navigation", question: "Which module would you use to customize your instances banner image, text and colors?", options: ["System UI > UI Pages > Branding", "Service Portal > Portals > Branding", "System Properties > Basic Configuration UI16"], answer: 2, explanation: "System Properties > Basic Configuration UI16 é o módulo de personalização visual do cabeçalho e marca da instância.", hint: "System Properties > Basic Configuration UI16." },
      { id: 134, domain: "Database Administration & CMDB", question: "Which database provides a logical model of your company infrastructure by identifying, controlling, maintaining and verifying CIs that exist?", options: ["IMDB", "ITSM", "CSDM", "CMDB"], answer: 3, explanation: "O CMDB (Configuration Management Database) é o banco de dados que armazena os ativos e itens de configuração e seus relacionamentos.", hint: "CMDB." },
      { id: 135, domain: "Data Migration & Integration", question: "Which module is used as the first step for importing data?", options: ["Coalesce Data", "Transform Data", "Import Data", "Load Data"], answer: 3, explanation: "O módulo 'Load Data' (System Import Sets > Load Data) é o primeiro passo para carregar o arquivo com os dados brutos.", hint: "Load Data." },
      { id: 136, domain: "Service Automation & Process Automation", question: "When you need to orchestrate business processes across services with little technical user knowledge, which utility would you use?", options: ["Flow Manager", "Flow Designer", "Flow Editor", "Workflow Editor"], answer: 1, explanation: "O Flow Designer é a ferramenta recomendada no-code/low-code para orquestração de fluxos de processo.", hint: "Flow Designer." },
      { id: 137, domain: "Core Configuration & Security", question: "When a user reports that they are not able to see modules on the application navigator, what can you do, to see what modules are visible to them?", options: ["Look up password", "Initiate Connect Chat", "Install Bomgar", "Impersonate the user"], answer: 3, explanation: "Ao personificar (Impersonate) o usuário, o administrador vê exatamente a interface, menus e permissões ativas para aquela pessoa.", hint: "Impersonate the user." },
      { id: 138, domain: "User Interface & Navigation", question: "What is a key difference between Reporting and Performance Analytics?", options: ["Performance Analytics contains snapshots of data taken over time; Reporting shows only current data.", "Performance Analytics can show trends; Reports cannot.", "Reports can be scheduled; PA cannot."], answer: 0, explanation: "Relatórios padrão consultam a base em tempo real no momento da execução; Performance Analytics coleta e armazena instantâneos (snapshots) para análise de tendências históricas.", hint: "Performance Analytics usa snapshots temporais (histórico); Relatórios consultam o estado atual." },
      { id: 139, domain: "User Interface & Navigation", question: "To change Priority values to display P1, P2, P3, P4 across all Tasks, what option do you select on Priority field?", options: ["Configure Lists", "Show Options", "Configure Task", "Show Choice List"], answer: 3, explanation: "Acessar a Lista de Escolhas (Show Choice List) no campo de escolha permite customizar ou traduzir os rótulos do campo.", hint: "Show Choice List." },
      { id: 140, domain: "Service Automation & Process Automation", question: "Which module would you use to create a new notification to notify users affected by network outages?", options: ["System Notification > Email > Notifications", "Administration > Notification Overview", "System Properties > Email > Settings"], answer: 0, explanation: "O módulo central para gerenciar e criar mensagens de notificação é System Notification > Email > Notifications.", hint: "System Notification > Email > Notifications." },
      { id: 141, domain: "Service Automation & Process Automation", question: "When designing a flow, how do you reference data from a record in that flow?", options: ["Drag the table icon onto flow", "Use condition builder", "Specify source table on data pill", "Drag the data pill onto the flow definition"], answer: 3, explanation: "Valores dinâmicos em um fluxo são referenciados arrastando e soltando pílulas de dados (Data Pills) do painel lateral para a ação.", hint: "Arrastar e soltar a pílula de dados (Data Pill)." },
      { id: 142, domain: "User Interface & Navigation", question: "On the Reports page, what sections allow you to see which reports are visible to different audiences? (Choose four.)", options: ["Group", "Department", "My reports", "Team", "Dashboards", "Global", "Admin", "Analytics", "All"], answer: [0, 2, 5, 8], explanation: "As abas de visibilidade na página inicial de Reports são: My reports, Group, Global e All.", hint: "My reports, Group, Global e All." },
      { id: 143, domain: "Data Migration & Integration", question: "Which tool is used to define relationships between fields in an import set table and a target table?", options: ["Transform Schema", "Schema Map", "Dictionary Map", "Transform Map"], answer: 3, explanation: "O Transform Map associa as colunas da tabela de importação temporária aos campos da tabela final no banco de dados.", hint: "Transform Map." },
      { id: 144, domain: "Collaboration & Service Catalog", question: "Which ServiceNow capability provides assistance to help users obtain information and perform tasks via messaging interface?", options: ["Agent Workspace", "Chat bot", "Virtual Agent", "Knowledge Chat"], answer: 2, explanation: "O Virtual Agent é a solução nativa de assistente virtual e chatbot conversacional.", hint: "Virtual Agent." },
      { id: 145, domain: "Service Automation & Process Automation", question: "Which feature allows you to automate business logic for a particular application such as approvals, tasks notifications, and record operations?", options: ["Flows", "Action Sequences", "Action Sets", "Task Flows"], answer: 0, explanation: "Fluxos (Flows) criados no Flow Designer executam lógicas de automação incluindo tarefas, aprovações e notificações.", hint: "Flows (Flow Designer)." },
      { id: 146, domain: "User Interface & Navigation", question: "From a form, what would you click to add additional fields to the form? (Choose two.)", options: ["Context Menu > Form > Layout", "Context Menu > Configure > Form Layout", "Context Menu > Configure > Form Design", "Right click on header > Add"], answer: [1, 2], explanation: "Campos adicionais são configurados através das opções Form Layout ou Form Design acessíveis no menu de contexto.", hint: "Configure > Form Layout e Configure > Form Design." },
      { id: 147, domain: "Database Administration & CMDB", question: "What is the name of the table relationship, where two or more tables are related in a bi-directional relationship visible in related lists?", options: ["Database View", "Many to Many", "One to Many", "Extended"], answer: 1, explanation: "Relacionamentos N para N (Many to Many) conectam registros de duas tabelas de forma bidirecional via tabela de junção.", hint: "Many to Many (M2M)." },
      { id: 148, domain: "User Interface & Navigation", question: "On a Form header, what is the three bar icon called?", options: ["Pancake icon", "Additional Actions or Context Menu", "Hamburger icon", "Cake icon"], answer: 1, explanation: "O ícone de três barras no cabeçalho do formulário é chamado de Additional Actions ou Context Menu (Menu de Contexto).", hint: "Additional Actions / Context Menu." },
      { id: 149, domain: "Core Configuration & Security", question: "Group records are stored in which table?", options: ["Group [sn_user_group]", "Group [sys_user_group]", "Group [s_sys_group]"], answer: 1, explanation: "A tabela de grupos de usuários no sistema é a `sys_user_group`.", hint: "sys_user_group." },
      { id: 150, domain: "Service Automation & Process Automation", question: "What function do you use to add buttons, links, and context menu items on forms and lists?", options: ["UI Policies", "UI Settings", "UI Actions", "UI Config"], answer: 2, explanation: "UI Actions adicionam elementos visuais interativos como botões, links de formulários e opções de menus contextuais.", hint: "UI Actions." },
      { id: 151, domain: "Service Automation & Process Automation", question: "On a Business Rule, what options are available for the 'When' timing setting?", options: ["Before, After, Async, Display", "Prior to, Synchronous, on Update", "Insert, Update, Delete, Query"], answer: 0, explanation: "O momento de execução (When) de uma Business Rule pode ser: Before, After, Async ou Display.", hint: "Before, After, Async, Display." },
      { id: 152, domain: "Data Migration & Integration", question: "What are different types of Data Sources, which may be imported into ServiceNow? (Choose four.)", options: ["Local Sources (i.e. XML, CSV, Excel)", "Implementation Spoke", "DataHub", "JDBC Connection", "Network Server", "LDAP Connection"], answer: [0, 3, 4, 5], explanation: "Fontes de dados válidas incluem: arquivos locais (CSV/Excel/XML), conexão JDBC, servidor de rede (FTP/SFTP) e conexão LDAP.", hint: "Arquivos Locais, Conexão JDBC, Servidor de Rede e Conexão LDAP." },
      { id: 153, domain: "User Interface & Navigation", question: "What are the components that make up a filter condition? (Choose three.)", options: ["Operator", "Match Criteria", "Value", "Column", "Field"], answer: [0, 2, 4], explanation: "A estrutura do filtro é composta por: Campo (Field), Operador (Operator) e Valor (Value).", hint: "Field, Operator, Value." },
      { id: 154, domain: "Core Configuration & Security", question: "When impersonating a user for testing purposes, what is the best way to return the instance logged in with your user account?", options: ["Turn computer off and on", "Clear browser cache", "End Impersonation", "Log out and back in"], answer: 2, explanation: "Para sair do modo de personificação e retornar à sua conta de administrador, clique na opção 'End Impersonation' no menu do usuário.", hint: "End Impersonation." },
      { id: 155, domain: "Collaboration & Service Catalog", question: "What controls the publishing and retiring process for knowledge articles?", options: ["Approval Policies", "Approval Definitions", "Workflow Designer", "Workflows"], answer: 3, explanation: "Workflows (ou fluxos) atribuídos à base de conhecimento gerenciam o ciclo de vida de aprovação, publicação e aposentadoria dos artigos.", hint: "Workflows." },
      { id: 156, domain: "User Interface & Navigation", question: "What type of query allows you to filter list data using normal words, instead of the condition builder?", options: ["Natural Language Query", "Alexa Query", "Machine Learning Query"], answer: 0, explanation: "O recurso Natural Language Query (NLQ) permite que usuários façam buscas em linguagem natural em listas de registros.", hint: "Natural Language Query (NLQ)." },
      { id: 157, domain: "Collaboration & Service Catalog", question: "From the Service Catalog, what are examples of tables having a one to many relationships? (Choose three.)", options: ["One Approval can have many Requests", "One Request can have many Requested Items", "One Requested Item can have many Approvals", "One Requested Item can have many Catalog Tasks", "One Cart can have many Requests"], answer: [1, 2, 3], explanation: "Exemplos de 1-para-Muitos: 1 REQ possui vários RITMs, 1 RITM possui várias aprovações, e 1 RITM possui várias tarefas de atendimento (SCTASK).", hint: "REQ para RITM, RITM para Approvals, RITM para Tasks." },
      { id: 158, domain: "User Interface & Navigation", question: "On a filter condition, which component is always a choice list?", options: ["Operator", "Filter Criteria", "Operation", "Match Criteria"], answer: 0, explanation: "O Operador (ex: é, contém, é um de) é sempre selecionado em uma lista de opções pré-definidas (Choice List).", hint: "Operator (Operador)." },
      { id: 159, domain: "Core Configuration & Security", question: "A Role is defined as what?", options: ["A collection of permissions", "A set of user access policies", "A Persona in a workflow", "A set of access control rules"], answer: 0, explanation: "Um papel (Role) é um grupo/coleção de permissões concedidas a usuários ou grupos.", hint: "Uma coleção de permissões (collection of permissions)." },
      { id: 160, domain: "Core Configuration & Security", question: "A user sees a blank page when clicking Create New in a custom application, but can see the module in navigation. What could cause this?", options: ["Broken link", "UI15 issue", "Browser issue", "User has read role, but not the write role on the table"], answer: 3, explanation: "A página em branco em ações de criação indica que a ACL autorizou a visualização do módulo (Read), mas bloqueou a permissão de criação/escrita na tabela (Write/Create).", hint: "Possui permissão de leitura, mas falta permissão de escrita (write/create)." },
      { id: 161, domain: "Database Administration & CMDB", question: "What resource can you use to view details of the tables and configuration items (CIs) associated with a particular use case?", options: ["Scenario Dashboard", "CI Use Case Modeler", "CMDB Use Case Modeler", "Common Service Data Model (CSDM) product view"], answer: 3, explanation: "A visão de produto do CSDM permite visualizar o mapeamento arquitetural dos CIs por casos de uso e serviços de negócio.", hint: "CSDM product view." },
      { id: 162, domain: "User Interface & Navigation", question: "A manager wants month-end Sales performance data compared to targets, trended over time and forecasted into the future. What capability do you suggest?", options: ["Scheduled Reports", "Reports and Excel", "Projection report", "Performance Analytics"], answer: 3, explanation: "Performance Analytics é a solução ideal para análise de KPIs, dados históricos com tendências e projeções/previsões futuras.", hint: "Performance Analytics." },
      { id: 163, domain: "Service Automation & Process Automation", question: "What are advantages of using Flow Designer? (Choose three.)", options: ["Supports advanced developers", "Enables complicated scripting", "Reduces technical debt", "Less manual scripting", "Smooth integration with 3rd party systems"], answer: [2, 3, 4], explanation: "Vantagens do Flow Designer: reduz débito técnico, minimiza necessidade de código/scripts manuais e integra facilmente com sistemas externos através de Spokes.", hint: "Reduz débito técnico, menos scripts manuais e integração simplificada." },
      { id: 164, domain: "Core Configuration & Security", question: "To monitor which users are performing impersonations in an instance, what would you do?", options: ["Add role Log Write to Impersonator Group", "Create user update set", "Activate the glide.sys.log_impersonation property", "Elevate Roles"], answer: 2, explanation: "Ativar a propriedade de sistema `glide.sys.log_impersonation` registra logs de todas as sessões de personificação realizadas.", hint: "Propriedade `glide.sys.log_impersonation`." },
      { id: 165, domain: "Service Automation & Process Automation", question: "When a flow runs an action, it generates a runtime value which stays the same for the duration of the flow. What is its name?", options: ["Trigger runtime value", "Sequence runtime value", "Starting runtime value", "Data pill runtime value"], answer: 3, explanation: "Cada ação gera um valor em tempo de execução encapsulado em uma pílula de dados (Data Pill).", hint: "Data pill runtime value." },
      { id: 166, domain: "User Interface & Navigation", question: "The wait time for end users is based on the round-trip between client and server. What activities are included in round-trips?", options: ["Request + Response", "Save + Update", "Write + Read", "Submit + Query"], answer: 0, explanation: "O tempo de idas e voltas (round-trip) mede o tempo da Requisição do cliente (Request) mais a Resposta do servidor (Response).", hint: "Request + Response." },
      { id: 167, domain: "Data Migration & Integration", question: "When importing data, what happens to imported rows if no coalesce field is specified?", options: ["All rows are rejected", "All rows are treated as new records. No existing records are updated.", "Duplicate rows are rejected"], answer: 1, explanation: "Sem um campo Coalesce definido para fazer a busca, a plataforma assume que todos os registros são novos e insere todos eles.", hint: "Todos os registros são inseridos como novos registros." },
      { id: 168, domain: "Core Configuration & Security", question: "What is the most common role that has access to almost all platform features, functions, and data?", options: ["Security Admin", "Sys Admin", "Admin", "System Administrator [admin]"], answer: 3, explanation: "O papel `admin` (System Administrator) concede acesso total à maioria esmagadora das funcionalidades da plataforma.", hint: "System Administrator [admin]." },
      { id: 169, domain: "Collaboration & Service Catalog", question: "What feature do you use to specify which users are able to access a Service Catalog Item?", options: ["Can Read Role", "Catalog User Role", "Can Order Tab", "User Criteria"], answer: 3, explanation: "User Criteria define quem tem permissão para visualizar e solicitar itens de catálogo específicos.", hint: "User Criteria." },
      { id: 170, domain: "Database Administration & CMDB", question: "Which component of a table contains a piece of data for one record?", options: ["Factor", "Field", "Datapoint", "Element"], answer: 1, explanation: "Um campo (Field) é o componente da tabela que armazena uma informação individual em um registro.", hint: "Field (Campo)." },
      { id: 171, domain: "User Interface & Navigation", question: "What type of field has a drop down list, from which you can pick from pre-defined options?", options: ["Choice", "Picker", "Drop down", "Option"], answer: 0, explanation: "Campos do tipo Choice exibem listas suspensas com valores de opção pré-definidos.", hint: "Choice." },
      { id: 172, domain: "Database Administration & CMDB", question: "User records are stored in which table?", options: ["User [sys_user]", "User [sn_user]", "User [u_sys_user]"], answer: 0, explanation: "Os cadastros de usuários ficam armazenados na tabela `sys_user`.", hint: "sys_user." },
      { id: 173, domain: "Service Automation & Process Automation", question: "What ServiceNow feature can be triggered by events, and is used to inform users about activities or updates?", options: ["Notifications", "Alerts", "Texts", "Events"], answer: 0, explanation: "Notificações (Notifications) são enviadas para alertar pessoas quando determinados eventos ocorrem no sistema.", hint: "Notifications." },
      { id: 174, domain: "Collaboration & Service Catalog", question: "Which ServiceNow capability allows you to provide knowledge articles via a conversational messaging interface?", options: ["Agent Assist", "Virtual Agent", "Now Messenger"], answer: 1, explanation: "O Virtual Agent interage via chat conversacional podendo recomendar e exibir artigos de conhecimento aos usuários.", hint: "Virtual Agent." },
      { id: 175, domain: "Collaboration & Service Catalog", question: "Which role can manage multiple knowledge bases?", options: ["knowledge_base_admin", "kb_admin", "sn_kb_admin", "knowledge_admin"], answer: 3, explanation: "O papel `knowledge_admin` concede permissões de administração e gerenciamento sobre todas as bases de conhecimento.", hint: "knowledge_admin." },
      { id: 176, domain: "Service Automation & Process Automation", question: "Which statement correctly describes the differences between a Client Script and a Business Rule?", options: ["Client Script runs on client and Business Rule runs on server", "Client Script runs on server and Business Rule runs on client", "Client Script executes before record load"], answer: 0, explanation: "Client Scripts executam do lado do cliente (no navegador), enquanto Business Rules executam do lado do servidor (no banco/plataforma).", hint: "Client Script = Navegador (Client), Business Rule = Servidor (Server)." },
      { id: 177, domain: "Core Configuration & Security", question: "What are benefits of assigning work tasks to a group, rather than to an individual? (Choose four.)", options: ["Group members can choose tasks from My Groups Work", "Groups can assign tasks based on on-call schedules", "Site support members pick by Location", "Groups can assign tasks based on skills", "Group members avoid SLA breach", "Groups can assign tasks based on availability"], answer: [0, 1, 3, 5], explanation: "Atribuir a grupos traz flexibilidade de carga de trabalho, roteamento por habilidades, verificação de disponibilidade e plantões.", hint: "Meus Grupos de Trabalho, Escala de Plantão, Habilidades e Disponibilidade." },
      { id: 178, domain: "User Interface & Navigation", question: "What ServiceNow feature allows you to include data from a secondary related table on a report?", options: ["SQL", "Dot Walking", "Outer Join", "Joins"], answer: 1, explanation: "Dot-Walking permite alcançar e incluir colunas de tabelas relacionadas em relatórios e filtros.", hint: "Dot Walking." },
      { id: 179, domain: "User Interface & Navigation", question: "What attributes can you manage, using System Properties > Basic Configuration UI16? (Choose five.)", options: ["Browser tab title", "Module text color", "Preferred browser", "Base theme", "Font style", "Animation style", "Header background color", "Banner Image"], answer: [0, 1, 3, 6, 7], explanation: "Atributos visuais no Basic Configuration UI16: Título da aba, Cor de texto dos módulos, Tema base, Cor de fundo do cabeçalho e Imagem do Banner.", hint: "Título da aba, Cor de texto do módulo, Tema base, Cor do cabeçalho e Imagem do banner." },
      { id: 180, domain: "Data Migration & Integration", question: "Which field (or fields) is used as a unique key during imports?", options: ["Match Fields", "Coalesce Fields", "Key Fields", "Sys IDs"], answer: 1, explanation: "O campo marcado com a opção Coalesce atua como chave única de identificação durante importações.", hint: "Coalesce Fields." },
      { id: 181, domain: "Collaboration & Service Catalog", question: "Which method would you use to create an option in Service Catalog allowing users to click 'Get Help' and create incident records?", options: ["Create Record Producer", "Create Catalog Item", "Create Order Guide"], answer: 0, explanation: "Record Producers geram registros de tarefas (como incidentes) através de formulários do catálogo de serviços.", hint: "Record Producer." },
      { id: 182, domain: "Core Configuration & Security", question: "What is the result of the order in which access controls are evaluated?", options: ["Ensures user has access to fields before table", "Ensures quick work", "Ensures access to app before module", "Ensures user has access to a table, before evaluating access to a field in the table"], answer: 3, explanation: "A ordem de avaliação garante que a permissão à Tabela seja verificada primeiro; se negada, o acesso a todos os campos é imediatamente bloqueado.", hint: "Acesso à tabela é verificado antes do acesso aos campos." },
      { id: 183, domain: "Database Administration & CMDB", question: "Which tool graphically displays an infrastructure view for a configuration item (CI) and its relationship with other CIs?", options: ["Schema Map", "Dependency View", "Dependency Map", "Database View"], answer: 1, explanation: "Dependency Views exibe a árvore gráfica de dependências e conexões de infraestrutura de um CI.", hint: "Dependency View." },
      { id: 184, domain: "Database Administration & CMDB", question: "What are examples of Core tables in the ServiceNow platform?", options: ["Configuration, Connect, Chat", "Team, Party, Awards", "User, Task, Incident", "Work, Caller, Timecard"], answer: 2, explanation: "Tabelas principais e nativas (Core Tables) fornecidas pela plataforma incluem User (`sys_user`), Task (`task`) e Incident (`incident`).", hint: "User, Task, Incident." },
      { id: 185, domain: "Collaboration & Service Catalog", question: "Which tab on the knowledge base record would you use to identify the sets of users who are able to read articles?", options: ["Access List", "Can Access", "Accessible to", "Can Read"], answer: 3, explanation: "A guia 'Can Read' na base de conhecimento define os User Criteria de quem pode ler os artigos contidos nela.", hint: "Can Read." },
      { id: 186, domain: "User Interface & Navigation", question: "What are the three key components of the Form Design interface? (Choose three.)", options: ["Field Layout", "Page Header", "Field Navigator", "Field Picker", "Form Layout"], answer: [1, 2, 4], explanation: "A tela da ferramenta Form Designer é composta pelo Cabeçalho da Página (Page Header), Navegador de Campos (Field Navigator) e Layout do Formulário.", hint: "Page Header, Field Navigator e Form Layout." },
      { id: 187, domain: "Collaboration & Service Catalog", question: "What is used to determine user access to knowledge bases or a knowledge article?", options: ["sn_kb_read", "Privacy Settings", "Read Access Flag", "User Criteria"], answer: 3, explanation: "User Criteria gerenciam o acesso de leitura e escrita a bases de conhecimento e artigos individuais.", hint: "User Criteria." },
      { id: 188, domain: "Database Administration & CMDB", question: "What are the three key tables in an enterprise CMDB? (Choose three.)", options: ["cmdb", "sn_cmdb_bak", "cmdb_rel_ci", "sn_cmdb", "cmdb_bak", "cmdb_ci", "sn_cmdb_ci"], answer: [0, 2, 5], explanation: "As três tabelas fundamentais do CMDB são: `cmdb` (tabela base de CIs), `cmdb_ci` (tabela estendida de CIs) e `cmdb_rel_ci` (relacionamentos entre CIs).", hint: "`cmdb`, `cmdb_ci` e `cmdb_rel_ci`." },
      { id: 189, domain: "Core Configuration & Security", question: "What is the best practice related to using the Default Update Set for moving customizations between instances?", options: ["Merge Default update sets", "Submit Default to app repo", "You should not use the Default Update sets for moving between instances", "Keep Default under 20 records"], answer: 2, explanation: "Nunca se deve utilizar o Default Update Set para migrar alterações entre ambientes.", hint: "Não utilizar o Default Update Set para transporte." },
      { id: 190, domain: "Core Configuration & Security", question: "On what part of the ServiceNow instance, would you find the option to Impersonate User?", options: ["Module", "Content Frame", "Application Navigator", "Banner"], answer: 3, explanation: "A opção Impersonate User fica no menu do perfil de usuário localizado no cabeçalho superior (Banner).", hint: "Banner / Cabeçalho Superior." },
      { id: 191, domain: "Data Migration & Integration", question: "Which application is used primarily to load data into ServiceNow?", options: ["Import Hub", "System Import Sets", "Data Import Configuration"], answer: 1, explanation: "System Import Sets é a aplicação oficial para carga de dados no sistema.", hint: "System Import Sets." },
      { id: 192, domain: "Collaboration & Service Catalog", question: "If a knowledge base has no access details specified, what users are able to read articles in that knowledge base?", options: ["itil users", "Any user with permalink", "Any active user", "No users"], answer: 2, explanation: "Se nenhuma restrição de User Criteria for configurada em uma base de conhecimento, qualquer usuário ativo pode ler os artigos.", hint: "Qualquer usuário ativo (Any active user)." },
      { id: 193, domain: "Core Configuration & Security", question: "How would you define an Access Control to allow a user with itil role permission to create incident records?", options: ["Name: incident.None; Operation: create; Role: itil", "Name: incident.Any; Operation: write", "Name: incident:*; Permission: write"], answer: 0, explanation: "A ACL para criar novos registros na tabela inteira deve ser definida com Name: `incident.None`, Operation: `create` e Role: `itil`.", hint: "incident.None + create + itil." },
      { id: 194, domain: "Collaboration & Service Catalog", question: "What Service Catalog feature do you use to organize items into logical groups?", options: ["Categories", "Variable Sets", "Sections", "Catalog items"], answer: 0, explanation: "Categorias (Categories) organizam itens de catálogo em grupos e subgrupos lógicos.", hint: "Categories (Categorias)." },
      { id: 195, domain: "Service Automation & Process Automation", question: "When creating a new notification, what must you define? (Choose three.)", options: ["Associated KB", "Inactive user settings", "Under what conditions is the notification sent", "Who receives the notification", "What the content of the notification"], answer: [2, 3, 4], explanation: "Na configuração de e-mails/notificações define-se: Quando enviar (When to send), Quem recebe (Who will receive) e O que enviar (What it will contain).", hint: "Quando enviar, Quem recebe e O que contém." },
      { id: 196, domain: "Core Configuration & Security", question: "Which of these workflows/solutions are included out of the box in the platform? (Choose three.)", options: ["Federal Workflows", "Customer Workflows", "Infrastructure Workflows", "Manufacturing Workflows", "Employee Workflows", "IT Workflows"], answer: [1, 4, 5], explanation: "Os fluxos de trabalho nativos da plataforma ServiceNow dividem-se em IT Workflows, Employee Workflows e Customer Workflows.", hint: "IT Workflows, Employee Workflows e Customer Workflows." },
      { id: 197, domain: "User Interface & Navigation", question: "An IT manager cannot see tasks assigned to their teams on 'My Groups Work'. What could explain this?", options: ["Assignment Group manager empty", "Manager no itil role", "Manager not in Service Desk group", "Manager is not a member of the Network and Hardware groups."], answer: 3, explanation: "O gerente não faz parte dos grupos em questão, e portanto a lista de grupo não inclui essas tarefas para ele.", hint: "O gerente não é membro dos grupos." },
      { id: 198, domain: "Collaboration & Service Catalog", question: "How to configure a catalog form so an employee orders a tablet and selects standard accessory options (case, stand, protector)? (Choose three.)", options: ["Create Catalog Item for Tablet, add variable set for options", "Create Record producer with check boxes", "On Shopping Cart config select Add Accessories", "Create one Catalog item for each accessory", "Create Catalog Item for tablet, add check box variables for accessories"], answer: [0, 3, 4], explanation: "Abordagens válidas de catálogo: Usar Variable Sets no item do Tablet, criar itens de catálogo separados para cada acessório ou adicionar variáveis de checkbox no item principal.", hint: "Variable Set no Tablet, Itens individuais para cada acessório e Checkboxes no item." },
      { id: 199, domain: "Database Administration & CMDB", question: "Which ServiceNow utility provides a modern interactive graphical interface to visualize configuration items and their relationships?", options: ["Dependency View", "CI Class Map", "Business Service Map"], answer: 0, explanation: "Dependency View gráfica e interativa mostra CIs e suas conexões.", hint: "Dependency View." },
      { id: 200, domain: "Core Configuration & Security", question: "What is the definition of a group?", options: ["Collection of subject matter experts", "Team of users", "Escalation pod", "A collection of users", "A department"], answer: 3, explanation: "Um Grupo (Group) é definido no ServiceNow como um conjunto/coleção de usuários (`A collection of users`).", hint: "Uma coleção de usuários." },
      { id: 201, domain: "User Interface & Navigation", question: "On the Reports page, what sections allow you to see which reports are visible to different audiences? (Choose four.)", options: ["Group", "Department", "My reports", "Team", "Global", "All"], answer: [0, 2, 4, 5], explanation: "Seções de visibilidade no módulo Reports: My reports, Group, Global e All.", hint: "Group, My reports, Global, All." },
      { id: 202, domain: "User Interface & Navigation", question: "On a filter condition, what is the element based on the table, user access rights, and columns called?", options: ["Label", "Column", "Data Element", "Field", "Attribute"], answer: 3, explanation: "O primeiro elemento de uma condição de filtro que lista as colunas acessíveis da tabela é o Campo (Field).", hint: "Field (Campo)." },
      { id: 203, domain: "Service Automation & Process Automation", question: "What feature would you use to manage 2 levels of approvals and automated notifications when ordering an iPhone?", options: ["Approval Chains", "Flows", "Approver Delegates", "Parent-Child Approvers"], answer: 1, explanation: "Fluxos (Flows) no Flow Designer gerenciam sequências complexas de aprovação multinível e notificações.", hint: "Flows (Flow Designer)." },
      { id: 204, domain: "Core Configuration & Security", question: "Groups are stored in what table?", options: ["User Group [user_groups]", "Groups [sys_user_groups]", "Group [sys_user_group]"], answer: 2, explanation: "A tabela técnica de armazenamento dos grupos é a `sys_user_group`.", hint: "sys_user_group." },
      { id: 205, domain: "User Interface & Navigation", question: "When managing tags, what are the visibility options? (Choose three.)", options: ["Groups and Users", "Me", "Roles and Permissions", "Everyone", "Admins"], answer: [0, 1, 3], explanation: "As opções de visibilidade ao criar uma Tag são: Me (Apenas eu), Groups and Users (Grupos e Usuários específicos) e Everyone (Todos).", hint: "Me, Groups and Users, Everyone." },
      { id: 206, domain: "Data Migration & Integration", question: "What module enables an administrator to define destinations for imported data on any ServiceNow table?", options: ["Field Transform", "Schema Map", "Transform Map", "Import Map"], answer: 2, explanation: "O Transform Map mapeia a tabela temporária para a tabela de destino no banco.", hint: "Transform Map." },
      { id: 207, domain: "User Interface & Navigation", question: "On the Form header, which icon do you use to access form templates?", options: ["Stamp", "Pages", "More Options (...)", "Paperclip"], answer: 2, explanation: "No menu de Mais Opções (...) no cabeçalho do formulário encontra-se o atalho para alternar/aplicar Templates.", hint: "More Options (...) / Três Pontinhos." },
      { id: 208, domain: "Service Automation & Process Automation", question: "When using the Data Pill Picker, use which keys to dot-walk to fields in other tables?", options: ["Plus, Minus", "Ctrl <, Ctrl >", "Arrows", "Shift F4"], answer: 2, explanation: "As setas (Arrows) no Data Pill Picker permitem navegar através dos campos de referência (dot-walking).", hint: "Arrows / Setas." },
      { id: 209, domain: "Core Configuration & Security", question: "In what order are Access Controls evaluated?", options: ["Field-level then Table-level", "Table-level - most specific to most general; then Field-level - most specific to most general"], answer: 1, explanation: "A avaliação de ACLs verifica primeiro as regras no nível de Tabela (do mais específico ao genérico) e depois as de Campo (do mais específico ao genérico).", hint: "Table-level depois Field-level (do mais específico ao geral)." },
      { id: 210, domain: "Service Automation & Process Automation", question: "What instance resource allows you to access guided tours, info about actions, and instructions in Flow Designer?", options: ["Docs", "Community", "Help Panel (question mark icon)", "Wiki"], answer: 2, explanation: "O painel de Ajuda (ícone de ponto de interrogação ?) abre a documentação contextual e ajuda guiada no Flow Designer.", hint: "Help Panel (ícone ?)." },
      { id: 211, domain: "User Interface & Navigation", question: "The Report Designer contains different sections. Which section specifies grouping and calculations?", options: ["Style", "Group by", "Configure", "Format"], answer: 2, explanation: "A aba Configure do Report Designer permite definir agrupamentos, cálculos de agregação e colunas do relatório.", hint: "Configure." },
      { id: 212, domain: "User Interface & Navigation", question: "What icon do you use to change the icon and color on a Favorite?", options: ["Clock", "Pencil", "Triangle", "Star"], answer: 1, explanation: "O ícone de Lápis (Pencil) permite editar a cor e o ícone de um atalho nos Favoritos.", hint: "Pencil (Lápis)." },
      { id: 213, domain: "Core Configuration & Security", question: "What is the best way to get hands-on experience with a new ServiceNow application?", options: ["Search wiki", "Read release notes", "Activate application plugin on personal dev instance (PDI)", "Activate on production"], answer: 2, explanation: "Testar e explorar novos plugins em uma Instância de Desenvolvimento Pessoal (PDI) é a prática recomendada.", hint: "Ativar em uma Personal Dev Instance (PDI)." },
      { id: 214, domain: "User Interface & Navigation", question: "When looking at a list, how to quickly filter to show only records with Category of Hardware?", options: ["Right click on Category header", "Right click on magnifier", "On the list, locate and right click on the value Hardware, select Show Matching", "Use breadcrumb"], answer: 2, explanation: "Clicar com o botão direito sobre o valor 'Hardware' na célula da lista e selecionar 'Show Matching' (Exibir Correspondente).", hint: "Botão direito no valor > Show Matching." },
      { id: 215, domain: "User Interface & Navigation", question: "To filter a list for Short Description containing 'email', how might you do that?", options: ["Column search: email", "Search box: email", "Click List Magnifier, on Short Description type *email, press enter"], answer: 2, explanation: "A busca por contendo texto em colunas utiliza o caractere curinga asterisco `*` antes da palavra (ex: `*email`).", hint: "Digitar *email na busca da coluna." },
      { id: 216, domain: "Data Migration & Integration", question: "When importing spreadsheet data into ServiceNow, what is the first step in the process?", options: ["Run Data Scrubber", "Set Coalesce", "Select Import Set", "Load Data"], answer: 3, explanation: "O primeiro passo do fluxo de importação é 'Load Data' (Carregar Dados).", hint: "Load Data." },
      { id: 217, domain: "Database Administration & CMDB", question: "What is a classic example of a scenario where tables have many-to-many (M2M) relationships?", options: ["Vendors can sell multiple products; and products can be sold by multiple vendors.", "Task trigger Workflows", "Requests contain Items"], answer: 0, explanation: "Relacionamento N-para-N clássico: Vários fornecedores vendem vários produtos e vice-versa.", hint: "Fornecedores e Produtos." },
      { id: 218, domain: "User Interface & Navigation", question: "What section on a task record would you use to see the most recent update made to a record?", options: ["Audit Log", "Timeline", "Activity", "Journal"], answer: 2, explanation: "A seção de Atividade (Activity / Activity Stream) exibe o histórico e as atualizações mais recentes do registro.", hint: "Activity." },
      { id: 219, domain: "Collaboration & Service Catalog", question: "How to allow managers to order computers, monitors, cards, and phones for new employees in one request?", options: ["Create Requested Item", "Create Record Producer", "Create On-boarding Bot", "Create Order Guide"], answer: 3, explanation: "Um Order Guide é o recurso indicado para agrupar e pedir múltiplos itens relacionados de uma só vez.", hint: "Order Guide." },
      { id: 220, domain: "Collaboration & Service Catalog", question: "Which interface allows users to search articles, submit requests, and browse communication notices?", options: ["Service Portal", "Employee Self Service", "Customer Service Management"], answer: 0, explanation: "O Service Portal é o portal web central para usuários finais encontrarem conhecimento e solicitarem serviços.", hint: "Service Portal." },
      { id: 221, domain: "User Interface & Navigation", question: "From a related list, what would a user click to personalize the layout of the columns?", options: ["Gear", "Context Menu", "Pencil", "Magnifier"], answer: 0, explanation: "O ícone de Engrenagem (Gear) no canto da lista relacionada permite personalizar as colunas exibidas para o usuário.", hint: "Gear (Engrenagem)." },
      { id: 222, domain: "Core Configuration & Security", question: "What is the language used for scripting in ServiceNow?", options: ["C++", "JavaScript", "PHP", "Python"], answer: 1, explanation: "JavaScript é a linguagem padrão utilizada para scripts no cliente e no servidor na plataforma ServiceNow.", hint: "JavaScript." },
      { id: 223, domain: "User Interface & Navigation", question: "What are examples of UI Actions relating to Lists? (Choose four.)", options: ["List Links", "List Choices", "List Buttons", "List Override", "List Context Menu", "List Control"], answer: [0, 1, 2, 4], explanation: "UI Actions em listas podem aparecer como: List Links, List Choices, List Buttons e List Context Menu.", hint: "List Links, List Choices, List Buttons e List Context Menu." },
      { id: 224, domain: "Collaboration & Service Catalog", question: "For 80 catalog items requiring the same 4 mandatory fields, what feature do you use?", options: ["Variable Set Template", "Create one Variable Set for the four variables, then add that variable set to each of the 80 catalog items", "Record Producer"], answer: 1, explanation: "Variable Sets permitem agrupar um conjunto de variáveis reusáveis e associá-las a múltiplos itens de catálogo de uma só vez.", hint: "Criar um Variable Set com os 4 campos e reusar nos 80 itens." },
      { id: 225, domain: "User Interface & Navigation", question: "A task worker asks how to monitor updates occurring to assigned records in real time. What do you suggest?", options: ["On My Work list, select Activity Stream icon to show a frame with live updates", "Click eyeglass icon", "Open Agent workspace"], answer: 0, explanation: "O ícone de Activity Stream na lista 'My Work' abre um painel com atualizações e comentários em tempo real.", hint: "Activity Stream na lista My Work." },
      { id: 226, domain: "Collaboration & Service Catalog", question: "What access does a user need to be able to import articles to a knowledge base?", options: ["sn_knowledge_import", "sn_knowledge_contribute", "Can contribute", "Can import"], answer: 2, explanation: "Estar configurado na lista 'Can contribute' (User Criteria) da base de conhecimento dá permissão para criar e importar artigos.", hint: "Can contribute." },
      { id: 227, domain: "Data Migration & Integration", question: "When importing data from a spreadsheet, which step defines where incoming data columns will be written?", options: ["Schedule Transform", "Field Matching", "Select Data Source", "Create Transform Map"], answer: 3, explanation: "A criação do Transform Map (Create Transform Map) estabelece o mapeamento de campos de origem e destino.", hint: "Create Transform Map." },
      { id: 228, domain: "User Interface & Navigation", question: "To apply a UI Policy to all views, which field should be set to true in its definition record?", options: ["Global", "Reverse if false", "On load", "Inherit"], answer: 0, explanation: "O campo 'Global' marcado como verdadeiro (`true`) faz com que a UI Policy seja aplicada em todas as exibições (Views) do formulário.", hint: "Campo Global = true." },
      { id: 229, domain: "Data Migration & Integration", question: "What are the steps for importing data using an import set?", options: ["Select file; Run automap", "Identity source; Import transform", "Load the data; Create transform map; Transform data; Clean up import table"], answer: 2, explanation: "Fluxo de importação completo: Load data -> Create transform map -> Transform data -> Clean up import table.", hint: "Load data -> Create transform map -> Transform data." },
      { id: 230, domain: "Service Automation & Process Automation", question: "Which type of scripts run in the browser?", options: ["Script Include Scripts", "Access Control Scripts", "Business Rule Scripts", "UI Policies and Client Scripts"], answer: 3, explanation: "UI Policies e Client Scripts executam no navegador do cliente.", hint: "UI Policies e Client Scripts." },
      { id: 231, domain: "Database Administration & CMDB", question: "Which modules can you use to create a new table? (Choose two.)", options: ["Dictionary", "Schema Map", "Tables", "Tables & Columns"], answer: [2, 3], explanation: "Novas tabelas podem ser criadas a partir dos módulos 'System Definition > Tables' e 'System Definition > Tables & Columns'.", hint: "Tables e Tables & Columns." },
      { id: 232, domain: "Database Administration & CMDB", question: "Which one of the following describes the primary operations performed against tables in ServiceNow?", options: ["Create, Read, Upload, Delete", "Capture, Rate, Write", "Create, Read, Write, Delete"], answer: 2, explanation: "As quatro operações fundamentais de banco de dados no ServiceNow são CRUD: Create, Read, Write (Update) e Delete.", hint: "Create, Read, Write, Delete (CRUD)." },
      { id: 233, domain: "Core Configuration & Security", question: "How is a user defined in ServiceNow?", options: ["Profile table", "A user is a record stored in the User [sys_user] table", "User Preference table"], answer: 1, explanation: "Cada usuário no ServiceNow é um registro armazenado na tabela `sys_user`.", hint: "sys_user." },
      { id: 234, domain: "Database Administration & CMDB", question: "Which utility gives a Service Desk agent the ability to trace from a Service to see which supporting CIs have active issues?", options: ["CI Dependency View", "Event Management Homepage", "Service Dashboard"], answer: 0, explanation: "CI Dependency View permite navegar visualmente do Serviço até os CIs de suporte identificando quais possuem alertas/chamados ativos.", hint: "CI Dependency View." },
      { id: 235, domain: "Service Automation & Process Automation", question: "Which feature enables process owners to organize Flow Designer content into digitized cross-enterprise processes via task board interface?", options: ["Flow Designer", "Workflow Editor", "Process Automation Designer"], answer: 2, explanation: "Process Automation Designer é a ferramenta de quadro Kanban para alinhar e unificar múltiplos fluxos em processos de toda a empresa.", hint: "Process Automation Designer." },
      { id: 236, domain: "Core Configuration & Security", question: "An IT user only sees Self Service on homepage after logging in. What issue could explain this? (Choose two.)", options: ["User account does not have itil role", "Account not approved", "Account not logged in properly", "Failed LDAP", "User account does not belong to any groups, which contain the itil role"], answer: [0, 4], explanation: "Para visualizar aplicações operacionais (como Incident e Change) o usuário precisa possuir a role `itil` diretamente ou herdada através de um Grupo.", hint: "Não possui a role ITIL e não pertence a grupo com a role ITIL." },
      { id: 237, domain: "User Interface & Navigation", question: "On a related list, which buttons are commonly used for managing the records on the list? (Choose three.)", options: ["Add", "Edit", "Publish", "Manage", "New"], answer: [0, 1, 4], explanation: "Os botões padrões nas listas relacionadas são: Add (Adicionar relação existente), Edit (Editar relacionamentos) e New (Criar novo registro).", hint: "Add, Edit, New." },
      { id: 238, domain: "Core Configuration & Security", question: "To make Incident numbers read-only for all users and Short Description mandatory across all applications, which type of policy to use?", options: ["Data Quality Policy", "Dictionary Design Policy", "Data Policy", "Field Criteria Policy"], answer: 2, explanation: "Data Policies impõem obrigatoriedade e restrições de leitura no nível de dados no servidor.", hint: "Data Policy." },
      { id: 239, domain: "User Interface & Navigation", question: "On what part of the instance would you find the option to access applications, like Incident Management?", options: ["Application Navigator", "Service Desk Homepage", "Self Service Module"], answer: 0, explanation: "O Application Navigator (menu lateral esquerdo) dá acesso a todas as aplicações e módulos autorizados.", hint: "Application Navigator." },
      { id: 240, domain: "Collaboration & Service Catalog", question: "What catalog tool would you use to create a catalog item or record producer?", options: ["Catalog Builder", "Workflow Designer", "Catalog Designer"], answer: 0, explanation: "Catalog Builder é a interface guiada visual moderna para criação e edição de itens de catálogo e Record Producers.", hint: "Catalog Builder." },
      { id: 241, domain: "User Interface & Navigation", question: "On a form, which type of field has an icon that can be clicked to see a preview of the associated record?", options: ["Lookup", "Preview", "Reference", "Snapshot"], answer: 2, explanation: "Campos do tipo Reference possuem o ícone de informação (`i`) ao lado que abre a pré-visualização (preview) do registro relacionado.", hint: "Reference." },
      { id: 242, domain: "User Interface & Navigation", question: "While on an Incident record, how would you add a Tag for 'Special Handling'?", options: ["Context menu > Add Tag", "Click on the More options (...) icon, click Add Tag, type Special Handling, press enter", "Tag choice list"], answer: 1, explanation: "No menu de mais opções (...) no canto superior direito do formulário, selecione Add Tag.", hint: "Menu de Mais opções (...) > Add Tag." },
      { id: 243, domain: "Collaboration & Service Catalog", question: "What feature allows you to limit who is able to contribute or read knowledge within a knowledge base?", options: ["Roles", "Groups", "User Criteria", "Categories"], answer: 2, explanation: "User Criteria gerenciam as regras de quem pode ler (Can Read) ou contribuir (Can Contribute) em bases de conhecimento.", hint: "User Criteria." },
      { id: 244, domain: "Core Configuration & Security", question: "When moving a homepage or dashboard between instances, what must you remember?", options: ["Manually add them to the update set", "They cannot be moved", "Automatically added"], answer: 0, explanation: "Homepages e Dashboards não são capturados automaticamente e precisam ser adicionados manualmente ao Update Set.", hint: "Adicionar manualmente ao Update Set." },
      { id: 245, domain: "Database Administration & CMDB", question: "What is the platform name for the Group table?", options: ["sys_groups", "group", "sys_user_group", "sys_group"], answer: 2, explanation: "A tabela de grupos no banco de dados chama-se `sys_user_group`.", hint: "sys_user_group." },
      { id: 246, domain: "Service Automation & Process Automation", question: "Many actions are included with flow designer, what are some frequently used core actions? (Choose four.)", options: ["Look for Update", "Create Record", "Ask for Approval", "Look Up Record", "Wait for Condition", "Wait for Match"], answer: [1, 2, 3, 4], explanation: "Ações essenciais padrão no Flow Designer: Create Record, Ask for Approval, Look Up Record e Wait for Condition.", hint: "Create Record, Ask for Approval, Look Up Record, Wait for Condition." },
      { id: 247, domain: "Core Configuration & Security", question: "What role enables someone to authorize a request, with no other permissions on the platform?", options: ["Approval Group", "Authorize", "Reviewer", "Approver [approver_user]"], answer: 3, explanation: "O papel `approver_user` concede permissão exclusiva para visualizar e aprovar solicitações de trabalho.", hint: "approver_user." },
      { id: 248, domain: "Collaboration & Service Catalog", question: "On the knowledge base record, which tab would you use to define which users are not able to write articles?", options: ["Can Contribute", "Cannot Author", "Can Read", "Can Write"], answer: 2, explanation: "Definir usuários na guia 'Can Read' restringe o acesso deles apenas para leitura de artigos, impedindo escrita.", hint: "Can Read (apenas leitura)." },
      { id: 249, domain: "Core Configuration & Security", question: "What types of entities can receive task assignments, in ServiceNow? (Choose two.)", options: ["Users", "Departments", "Groups", "Teams"], answer: [0, 2], explanation: "No ServiceNow, tarefas só podem ser atribuídas a Usuários (`sys_user`) ou a Grupos (`sys_user_group`).", hint: "Users e Groups." },
      { id: 250, domain: "User Interface & Navigation", question: "The Report Designer contains different sections. Which section is used to adjust colors, titles and legend layout?", options: ["Layout", "Format", "Configure", "Style"], answer: 3, explanation: "A guia Style (Estilo) do Report Designer personaliza aspectos visuais como cores, título, fontes e legendas.", hint: "Style (Estilo)." },
      { id: 251, domain: "Database Administration & CMDB", question: "How would you distinguish between a Base Class table and a Parent Class table?", options: ["Extended tables are always extended from Parent tables. Extended tables are usually extended from Base tables.", "Extended tables can be extended from Parent tables or Base tables; but they cannot be extended from both.", "Base Class tables always have tables extended from them. Parent tables do not have tables extended from them.", "Base Class table is not extended from another table, Parent class tables may be extended from another table."], answer: 3 },
      { id: 252, domain: "Core Configuration & Security", question: "When a custom table is created, which access control rules are automatically created? (Choose four.)", options: ["create", "delete", "execute", "update", "read", "write"], answer: [0, 1, 4, 5] },
      { id: 253, domain: "User Interface & Navigation", question: "Which banner icon do you use to change your personal system settings, like your instance color scheme?", options: ["Magnifier", "Question mark", "Gear", "Chat bubbles"], answer: 2 },
      { id: 254, domain: "User Interface & Navigation", question: "Which banner icon do you use to change your personal system settings, like your instance color scheme?", options: ["Magnifier", "Question mark", "Gear", "Chat bubbles"], answer: 2 },
      { id: 255, domain: "Database Administration & CMDB", question: "When building an extended table from a base table, which fields do you need to create? (Choose two.)", options: ["The fields that are not in the base table.", "The mandatory fields for the base table.", "The fields that are specific to the extended table.", "The reference fields for the base table."], answer: [0, 2] },
      { id: 256, domain: "User Interface & Navigation", question: "While showing a customer their Incident form, they ask to change the Priority field title to display their internal terminology PValue. How would you do that? (Choose two.)", options: ["Right click on Priority and select Configure Label", "Right click on Priority and select Configure Dictionary", "Right click on Priority and select Configure Display Settings", "Right click on Priority and select Configure Column"], answer: [0, 1] },
      { id: 257, domain: "Core Configuration & Security", question: "As administrator, what must you do to access features of High Security Settings?", options: ["Impersonate Security Admin", "Select Elevate Roles", "Add security_admin role to your user account", "Use System Administration > Elevate Roles module"], answer: 1 },
      { id: 258, domain: "User Interface & Navigation", question: "What section on the notes tab, shows the history of the work documented on the record?", options: ["Audit Log", "Timeline", "Journal", "Diary", "Activity"], answer: 4 },
      { id: 259, domain: "Database Administration & CMDB", question: "How would you navigate to the Schema map for a table?", options: ["System Definition > Tables; Select Table; Go to Related links and click Show Schema Map", "System Dictionary > Show Schema Map; Select Table", "System Definition > Show Schema Map; Select Table", "System Definition > Dictionary; Select Table; Go to Related links and click Show Schema Map"], answer: 0 },
      { id: 260, domain: "Database Administration & CMDB", question: "Which is the base table of the configuration management database hierarchy?", options: ["cmdb_ci", "cmdb", "cmdb_rel_ci", "ucmdb"], answer: 1 },
      { id: 261, domain: "Database Administration & CMDB", question: "Which best describes a field in a ServiceNow table?", options: ["A field is a table row.", "A field is an item that appears in a menu list.", "A field is a table cell that stores data.", "A field is a record in a table."], answer: 2 },
      { id: 262, domain: "User Interface & Navigation", question: "What are examples of UI Actions relating to forms? (Choose three.)", options: ["Form Columns", "Form View", "Form Buttons", "Form Context Menu", "Form Links"], answer: [2, 3, 4] },
      { id: 263, domain: "Collaboration & Service Catalog", question: "Here is an example of the criteria set for a knowledge base: Companies: ACME North America Departments: HR Groups: ACME Managers Match All: Yes. In this example, what users would have access to this knowledge base?", options: ["Members of the ACME Manager group, who are also members of HR Department and part of ACME North America", "Employees of ACME North America, who are members of HR Department or the ACME Managers group", "Users which are members of either ACME North America, or HR Department, or ACME Managers group", "Members of the ACME Managers group, and HR department, regardless of geography"], answer: 0 },
      { id: 264, domain: "Service Automation & Process Automation", question: "In Flow Designer, where is the data from an action stored so it can be used in subsequent actions in the flow?", options: ["Data Pill", "Data Element", "Data Trigger", "Field Value", "Field Icon"], answer: 0 },
      { id: 265, domain: "Core Configuration & Security", question: "A customer has asked for the following updates to a form: Make Resolution code Mandatory, when state is changed to Resolved. Hide Major Incident check box, unless logged in user has Major Incident Manager role. What type of rule(s) would you use to implement this requirement?", options: ["Form Constraint", "UI Design", "Field Limiter", "UI Policy", "Dictionary Design"], answer: 3 },
      { id: 266, domain: "Collaboration & Service Catalog", question: "What setting allows users to view a Knowledge Base article even if they are not logged in?", options: ["The Public setting", "The View All setting", "The ESS role", "The Allow All role"], answer: 0 },
      { id: 267, domain: "User Interface & Navigation", question: "When adding a related list to a form, you choose the related list from the list collector. What is an example of a related list you might see on the list collector? (Choose three.)", options: ["Problem-Parent", "HR Case->Parent", "Catalog Task->Parent", "Outage->Task number", "Release Phase Parent"], answer: [1, 2, 3] },
      { id: 268, domain: "Service Automation & Process Automation", question: "How is the ServiceNow platform set up so that Administrators can easily configure their instances to send an email at the end of an upgrade?", options: ["Administrators can update the email notification named \"System Upgraded\" in the System Logs module by adding the appropriate User to receive it.", "Administrators can update the email notification named \"System Upgraded\" in the Notifications module by adding the appropriate User to receive it.", "Administrators can write a Client Script to send out an email to the Administrator when an Update is complete.", "Administrators can write a Business Rule to send out an email to the Administrator when an Update is complete."], answer: 1 },
      { id: 269, domain: "Database Administration & CMDB", question: "A customer wants to be able to identify and track components of their infrastructure that support their eCommerce service. What ServiceNow products could support this requirement? (Choose three.)", options: ["Asset Management", "Discovery", "Configuration Management (CMDB)", "Service Mapping", "Performance Analytics"], answer: [1, 2, 3] },
      { id: 270, domain: "Database Administration & CMDB", question: "For your implementation, the following tables are extended from each other: Incident table is extended from Task table. Super Incident table is extended from Incident table. In this situation, which table(s) are Parent, Child and Base tables? (Choose five.)", options: ["Super Incident table is a Parent table", "Incident table is a Child table", "Super Incident table is a Base table", "Incident table is a Base table", "Task table is a Child table", "Incident table is a Parent table", "Super Incident table is a Child table", "Task table is a Parent table", "Task table is a Base table"], answer: [1, 5, 6, 7, 8] },
      { id: 271, domain: "User Interface & Navigation", question: "What capability allows users to create dashboards with widgets to visualize data over time in order to identify areas of improvement?", options: ["Scheduled Reports", "Performance Analytics", "Analytics Reports", "Reporting"], answer: 1 },
      { id: 272, domain: "Service Automation & Process Automation", question: "Which type of ServiceNow script runs on the web browser?", options: ["Server script", "Database script", "Client script", "Local script"], answer: 2 },
      { id: 273, domain: "Data Migration & Integration", question: "When selecting the Target table for an import, which tables can you select? (Choose three.)", options: ["Tables outside of ServiceNow", "Tables within the global scope", "Related tables, using Dot Walk", "Tables which allow write access to other applications", "Tables within the existing application scope"], answer: [1, 3, 4] },
      { id: 274, domain: "Core Configuration & Security", question: "On Access Control Definitions, what are ways you can set the permissions on a Table? (Choose three.)", options: ["Conditional Expressions", "Roles", "CRUD", "Script that sets the answer variable to true or false", "Groups"], answer: [0, 1, 3] },
      { id: 275, domain: "Data Migration & Integration", question: "What tool is used to import data from various data sources, and map that data into ServiceNow tables?", options: ["Transform Set", "Data Pack", "Update Set", "Import Set"], answer: 3 },
      { id: 276, domain: "Core Configuration & Security", question: "When you set a policy that is applied to all data entered into the platform (UI, Import Sets, or Web Services), where does this policy run by default?", options: ["Client", "Network", "Browser", "Server"], answer: 3 },
      { id: 277, domain: "User Interface & Navigation", question: "On what part of the ServiceNow instance, would you find the option to Impersonate User?", options: ["User Menu", "Content Fame", "Application Navigator", "Module"], answer: 0 },
      { id: 278, domain: "Database Administration & CMDB", question: "How would you describe the relationship between the Incident and Task table?", options: ["Incident table has a one to many relationship with the Task table", "Incident table is extended from Task table", "Incident table is related to the Task table via the INC number", "Incident table has a many to many relationship with the Task table", "Incident table is a database view of the Task table"], answer: 1 },
      { id: 279, domain: "Service Automation & Process Automation", question: "Which flow components allow you to specify when a flow should be run?", options: ["Trigger and Condition Pill", "Condition and Table", "Trigger Criteria and Clock", "Trigger and Condition", "Scope and Trigger Condition"], answer: 3 },
      { id: 280, domain: "User Interface & Navigation", question: "Which feature helps to automatically allocate a critical, high-priority, service request to the appropriate assignment group or team member?", options: ["Assignment Rule", "User Policy", "Predictive Intelligence", "UI Policy"], answer: 0 },
      { id: 281, domain: "User Interface & Navigation", question: "The Report Designer contains different sections for configuring your report. Which section is used to specify the name of the report, and the table or data source for the report?", options: ["Type", "Properties", "Configure", "Sources", "Data"], answer: 4 },
      { id: 282, domain: "User Interface & Navigation", question: "You are editing a new incident record and would like the \"Save\" button to be located on the Form header. Which action would need to be taken for that button to appear?", options: ["Context Menu > Form Design > add the \"Save\" button.", "All > System Properties > UI Properties > Turn on the \"glide.ui.advanced\" property.", "All > System Properties > UI Properties > Turn on the \"Save\" button.", "Context Menu > Form Layout > add the \"Save\" button."], answer: 2 },
      { id: 283, domain: "Data Migration & Integration", question: "Which features ensures data consistency while importing data using import sets and web services?", options: ["UI Policy", "Data Policy", "Business Rule", "Client Script", "CSDM"], answer: 1 },
      { id: 284, domain: "Service Automation & Process Automation", question: "When using Flow Designer, what is the Flow Execution initiated by?", options: ["A flow logic", "An existing subflow", "An execution data pill", "A trigger"], answer: 3 },
      { id: 285, domain: "User Interface & Navigation", question: "What is the name of the string that displays filter criteria?", options: ["Breadcrumb", "Choice", "Menu", "Topic"], answer: 0 },
      { id: 286, domain: "Core Configuration & Security", question: "Which system property is added and set to true in order to see impersonation events in the System Log?", options: ["glide.sys.all_impersonation", "glide.user_setting", "glide.impersonation_setting", "glide.sys.log_impersonation", "glide.sys.admin_login"], answer: 3 },
      { id: 287, domain: "Collaboration & Service Catalog", question: "What process allows users to create, categorize, review, approve and browse important information in a centralized location that is shared by the entire organization?", options: ["Self Service Management", "Knowledge Management", "Business Information Management", "Information Portal Management", "Knowledge-Centered Management"], answer: 1 },
      { id: 288, domain: "User Interface & Navigation", question: "A colleague wants to rearrange the columns on their My Work List. Once the user has navigated to the list, where should they navigate to select and arrange the columns?", options: ["Right click on any column header, Context Menu > Configure > List Layout", "Click List Context Menu > Configure> List Layout", "Click List Context Menu > Personalize List", "Click Personalize List"], answer: 3 },
      { id: 289, domain: "User Interface & Navigation", question: "You are looking at a list of Active Incidents. You want to exclude Incidents with the state of Resolved. How might you do that?", options: ["On Search, select State, type not Resolved, press enter", "On State column title, right-click, select Filter Out > Resolved", "On the list of records, locate and right-click on the Resolved value, select Filter Out", "On the list of records, locate and right-click on the Resolved value, select Exclude", "Click Funnel icon, click AND, Select Resolved, is Not, State, click Run"], answer: 2 },
      { id: 290, domain: "Core Configuration & Security", question: "Roles can inherit permissions from other roles. Which role inherits all of the permissions of the catalog role, and the user_criteria_admin role, plus has permissions to create Items and Services?", options: ["Sys Admin [sys_admin]", "Catalog Admin [catalog_admin]", "Catalog Author [sn_catalog_write]", "Item Admin [sn_item_admin]"], answer: 1 },
      { id: 291, domain: "Database Administration & CMDB", question: "What component of the ServiceNow infrastructure defines every table and field in the system?", options: ["Schema", "Field Map", "Table Class Manager", "Dictionary", "Data Atlas"], answer: 3 },
      { id: 292, domain: "Core Configuration & Security", question: "Which data consistency settings can be achieved using UI Policy? (Choose three.)", options: ["Setting fields to accept the data in an expected format", "Setting fields to accept the data with 'n' number of characters", "Setting fields hidden", "Settings fields read-only", "Setting fields mandatory"], answer: [2, 3, 4] },
      { id: 293, domain: "Service Automation & Process Automation", question: "A customer wants to use a client script to validate things on a form in order to make sure the submission makes sense. What type of client script would you recommend to meet this requirement?", options: ["onSubmit()", "onSubmission()", "onUpdate()", "onLoad()"], answer: 0 },
      { id: 294, domain: "Collaboration & Service Catalog", question: "An order from the Service Catalog has been placed. Two records in the Platform are created as a result. Which two records are associated with this newly ordered item? (Choose two.)", options: ["A record of sc_req_item table", "A record of sc_task", "An incident record", "A change record", "A problem record"], answer: [0, 1] },
      { id: 295, domain: "User Interface & Navigation", question: "What action will allow you to personalize layouts of columns in a list?", options: ["Context Menu > View > Personalize", "Click Gear Icon > Personalize window options > Select the appropriate columns", "Select the column to be personalized and right at the header > Choose the options to personalize", "Select the column to be personalized > Click Edit icon (Pencil) > Choose the options to personalize"], answer: 1 },
      { id: 296, domain: "Collaboration & Service Catalog", question: "An order for new office equipment has been placed through the Service Catalog. How would you view the lists of requests after the orders have been placed?", options: ["All > Tables and Columns > Tasks", "In the Navigation Filter, type \"requests.list\" and press the Enter key", "All > Service Catalog > Requests", "All > Service Catalog > Open Records > Items"], answer: 3 },
      { id: 297, domain: "Database Administration & CMDB", question: "Which path would you take to access the table configuration page from a form?", options: ["The Form Context menu > View > Show Table", "The Form Context menu > View > Table", "The Form Context menu > Configure > Dictionary", "The Form Context menu > Configure > Table"], answer: 3 },
      { id: 298, domain: "Core Configuration & Security", question: "Which admin role is required to make changes to High Security Settings?", options: ["high_sec_admin", "sn_acl_admin", "admin", "security_admin"], answer: 3 },
      { id: 299, domain: "Core Configuration & Security", question: "What is the most common role that has access to almost all platform features, functions, and data?", options: ["Super User [sn_super_user]", "Security Admin [securty_admin]", "System Administrator [admin]", "Base Admin [base_admin]", "System Manager [sys_manager]"], answer: 2 },
      { id: 300, domain: "Core Configuration & Security", question: "When moving multiple update sets at one time, what might you do to facilitate the move?", options: ["Preview", "Batch", "List", "Map"], answer: 1 },
      { id: 301, domain: "User Interface & Navigation", question: "What do you click when you have made modifications to your report, and you want to see the results without saving?", options: ["Preview", "Test", "Run", "Try It", "Execute"], answer: 2 },
      { id: 302, domain: "Service Automation & Process Automation", question: "Which framework can automatically populate values for the Priority and Category fields based on the Short description field value?", options: ["Predictive Intelligence", "Assignment Rule", "CSDM", "Action", "UI Policy"], answer: 0 },
      { id: 303, domain: "Service Automation & Process Automation", question: "Which testing framework is used to test ServiceNow Applications?", options: ["Test Driven Framework (TDF)", "Junit", "Selenium", "Automated Test Framework (ATF)"], answer: 3 },
      { id: 304, domain: "Collaboration & Service Catalog", question: "Which allows the creation of a task-based record from Service Catalog?", options: ["Assignment Rule", "Flow Designer", "UI Builder", "Record Producers"], answer: 3 },
      { id: 305, domain: "User Interface & Navigation", question: "What module do you use to access the reports that are available to you?", options: ["Self-Service > My Reports", "Self-Service > My Dashboards", "Reports > View / Run", "Reports > Homepage", "Reports > Overview"], answer: 2 },
      { id: 306, domain: "Core Configuration & Security", question: "Security rules are defined to restrict the permissions of users from viewing and interacting with data. What are these security rules called?", options: ["CRUD Rules", "Access Control Rules", "Role Assignment Rules", "Scripted User Rules", "User Authentication Rules"], answer: 1 },
      { id: 307, domain: "Core Configuration & Security", question: "A new employee joins the IT department and needs to perform work assigned to Network and Hardware groups. How would you set up their access? (Choose three.)", options: ["Add User Account to Hardware group", "Add User Account to IT Knowledgebase", "Create User Account", "Add User Account to itil group", "Add User Account to Network group", "Add User Account to ACL"], answer: [0, 2, 4] },
      { id: 308, domain: "User Interface & Navigation", question: "The customer has asked that you change the default layout of the Task list. They would like these columns, in this order: Number, Task Type, Parent, Short Description, Assignment Group, Assignee, Updated. After navigating to the list, where would you click, to meet this requirement?", options: ["Click List Context Menu > Personalize List", "Click List Context Menu > Configure > Columns", "Right click List Gear icon > Configure > Columns", "Right click on any column header, Context Menu > Configure > List Layout"], answer: 3 },
      { id: 309, domain: "Collaboration & Service Catalog", question: "Which ServiceNow capability allows you to provide knowledge articles, via a conversational messaging interface?", options: ["Agent Assist", "Virtual Agent", "Now Messenger", "Instance Chat"], answer: 1 },
      { id: 310, domain: "User Interface & Navigation", question: "On the Form header, which element you to access form templates?", options: ["Stamp", "More Options (...)", "Pages", "Paperclip"], answer: 1 },
      { id: 311, domain: "Core Configuration & Security", question: "What is the definition of a group?", options: ["A collection of subject matter experts", "A department", "An escalation pod", "A collection of users", "A collection of tasks"], answer: 3 },
      { id: 312, domain: "Database Administration & CMDB", question: "Which ServiceNow utility provides a modern interactive graphical interface to visualize configuration items and their relationships?", options: ["Flow Design", "CI Class Map", "Dependency View", "Business Service Map"], answer: 2 },
      { id: 313, domain: "User Interface & Navigation", question: "What icon do you use to change the label on a Favorite?", options: ["Star", "Clock", "Triangle", "Pencil"], answer: 3 },
      { id: 314, domain: "Data Migration & Integration", question: "Which tool is used to define relationships between fields in an import set table and a target table?", options: ["Schema Map", "Field Transformer", "Transform Map", "Transform Schema"], answer: 2 },
      { id: 315, domain: "Core Configuration & Security", question: "When moving a homepage or dashboard between instances, what must you remember?", options: ["Download both as PDF and XML files", "They cannot be moved via update set", "The Platform will automatically add them to the update set", "Manually add them to the update set"], answer: 3 },
      { id: 316, domain: "Collaboration & Service Catalog", question: "Which allows the creation of a task-based record from Service Catalog?", options: ["Record Producers", "UI Builder", "Assignment Rule", "UI Actions", "Flow Designer"], answer: 0 },
      { id: 317, domain: "Collaboration & Service Catalog", question: "On the knowledge base record, which tab would you use to define which users are able to write articles to the knowledge base?", options: ["Can Contribute", "Cannot Author", "Can Read", "Can Write", "Can Author"], answer: 0 },
      { id: 318, domain: "Service Automation & Process Automation", question: "Which type of scripts run in the browser?", options: ["UI Policies", "Script Include Scripts", "Access Control Scripts", "Business Rule Scripts"], answer: 0 },
      { id: 319, domain: "Database Administration & CMDB", question: "What enables you to trace the connection from an infrastructure item, like a Server, to the Services that are dependent on that Server?", options: ["Automapping Utility", "Relationships", "Service Tracer", "Transform Map"], answer: 1 },
      { id: 320, domain: "User Interface & Navigation", question: "What section on a task record is used to see the most recent updates made to a record?", options: ["Timeline", "Related List", "Activity Stream", "Audit Log"], answer: 2 },
      { id: 321, domain: "Database Administration & CMDB", question: "While using the CMDB, what do you call the component that needs to be managed in order to deliver services?", options: ["Configuration Item", "Asset", "Catalog Items", "Data Plow", "Service Offerings"], answer: 0 },
      { id: 322, domain: "Data Migration & Integration", question: "What is the first step in the process to import spreadsheet data into ServiceNow?", options: ["Select Import Set", "Run Data Scrubber", "Define Data Source", "Create import Set", "Set Coalesce"], answer: 2 },
      { id: 323, domain: "Data Migration & Integration", question: "What are the steps for importing data using an import set?", options: ["Create Import Set; Create transform map; Transform data; Clean up import table", "Create a Transform Map, Load Data, Transform Data, Run Transform Map Script", "Identify source; Import transform map; Run transformer; Verify import", "Select source file; Run AutoMap; Transform data; Clean up target table"], answer: 0 },
      { id: 324, domain: "User Interface & Navigation", question: "If users would like to locate and assign a task to themselves in the Platform, what action could they perform from the list view to make the assignment? (Choose two.)", options: ["Select the record using the check box, then select the Person icon", "Select the record using the check box then select the Assign To Me UI action on the List Header", "Double click on the Assigned to value, type the name of the user, and select the green check", "Right click on the Task number and select the Assign to me option in the menu", "Select the Task number, and select the Assign to me UI action on the form"], answer: [2, 3] },
      { id: 325, domain: "Data Migration & Integration", question: "What module enables an administrator to define destinations for imported data on any ServiceNow table?", options: ["Load Data", "Field Transform", "Schema Map", "Transform Map"], answer: 3 },
      { id: 326, domain: "Collaboration & Service Catalog", question: "Which ServiceNow capability provides assistance to help users obtain information, make decisions, and perform common work tasks via a messaging interface?", options: ["Now Support", "ServiceNow Messenger", "Agent Workspace", "Virtual Agent", "Knowledge Chat"], answer: 3 },
      { id: 327, domain: "Service Automation & Process Automation", question: "What instance resource allows you to access guided tours, information about actions, and instructions on how to use inputs and outputs in your flow?", options: ["Now Support", "Community", "Docs", "Help Panel (question mark icon)"], answer: 3 },
      { id: 328, domain: "Data Migration & Integration", question: "When importing data from a spreadsheet, which step defines where the incoming data columns will be written in the receiving table?", options: ["Select Data Source", "Schedule Transform", "Load Data", "Create Transform Map", "Field Alignment"], answer: 3 },
      { id: 329, domain: "User Interface & Navigation", question: "On a form header, what icon would you click to access Template features?", options: ["Context Menu", "Paper clip", "Stamp", "More options (...)"], answer: 3 },
      { id: 330, domain: "Core Configuration & Security", question: "Access Control rules are applied to a specific table, like the Incident table. What is the object name for a rule that applies to the entire Incident table (all rows and fields)?", options: ["incident.*", "incident.all", "incident.!", "incident.None"], answer: 3 },
      { id: 331, domain: "User Interface & Navigation", question: "On a list, what does each row show?", options: ["A filter", "A record", "A table", "A field"], answer: 1 },
      { id: 332, domain: "User Interface & Navigation", question: "Which action enables personalization in a form for the admin role, only?", options: ["Navigate to sys_form_properties.list and set the property glide.ui.enable_personalize_form.admin to true.", "Navigate to Context Menu > Configure > Form Layout and select 'Enable Personalization' and Enter the 'admin' role.", "Navigate to Context Menu > Configure > Table and add the role 'Admin' in the 'Available User' list box.", "Navigate to sys_properties.list find the property glide.ui.personalize_form.role and set the Value to admin."], answer: 3 },
      { id: 333, domain: "User Interface & Navigation", question: "Which element is used to track items not saved with a field, in a record?", options: ["Sidebar", "List Editor", "Activity formatter", "Dictionary"], answer: 2 },
      { id: 334, domain: "Data Migration & Integration", question: "What does ServiceNow recommend as a best practice regarding data imports?", options: ["Adjust your Transform maps, after the data is loaded into the target table.", "Use extremely large Import Sets, instead of multiple large Import Sets.", "Create a new Import set table for each new data load.", "Plan time before your import to remove obsolete or inaccurate data.", "Monitor data quality and clean imported data, using the Data Scrub Workspace."], answer: 3 },
      { id: 335, domain: "Core Configuration & Security", question: "When an administrator sets a policy that is applied to all data entered into the Platform (UI, Import Sets, or Web Services), where does this policy run by default?", options: ["Network", "Server", "Client", "Browser"], answer: 1 },
      { id: 336, domain: "Service Automation & Process Automation", question: "If a user is on an Incident form and is alerted when they change the value of the Priority field, which type of script executes in the Platform?", options: ["A server script", "A client script", "A fix script", "A business rule"], answer: 1 },
      { id: 337, domain: "User Interface & Navigation", question: "Which feature can be used to categorize a set of records from a list and make them visible to other users?", options: ["Tags", "History", "Favorites", "Activity Formatter"], answer: 0 },
      { id: 338, domain: "Core Configuration & Security", question: "The testing team needs to be able to perform activities in the test instance, as though they are a member of the Service Desk group. What role would they need to be able to switch between user accounts, without logging out and back in?", options: ["service_desk", "impersonator", "admin", "incognito"], answer: 1 },
      { id: 339, domain: "Service Automation & Process Automation", question: "What are the benefits of building flows using Flow Designer? (Choose three.)", options: ["Provides IDE for complicated scripting", "Provides built-in libraries /API for complex coding", "Automatically populates SLA records", "Provides natural-language descriptions of flow logic", "Supports No-Code application development", "Supports easy integration with 3rd party systems"], answer: [3, 4, 5] },
      { id: 340, domain: "Database Administration & CMDB", question: "Which helps to visualize configuration items and their relationships?", options: ["Tables", "Schema Map", "Flow Design", "Transform Map", "Dependency View"], answer: 4 },
